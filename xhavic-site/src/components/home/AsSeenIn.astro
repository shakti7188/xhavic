---
/**
 * AsSeenIn — Logo marquee strip
 * Infinite horizontal scroll of partner/media logos.
 * Duplicates track innerHTML for seamless loop animation.
 */
---

<section class="logo-marquee" aria-label="Featured in">
  <h3 class="marquee-heading">As seen in</h3>
  <div class="marquee-track">
    <div class="logo"><img src="/images/as-seen-in/1.png" alt="CNN logo" /></div>
    <div class="logo"><img src="/images/as-seen-in/2.png" alt="Bloomberg logo" /></div>
    <div class="logo"><img src="/images/as-seen-in/3.png" alt="Wired logo" /></div>
    <div class="logo"><img src="/images/as-seen-in/4.png" alt="Sky News logo" /></div>
    <div class="logo"><img src="/images/as-seen-in/5.png" alt="The Block logo" /></div>
    <div class="logo"><img src="/images/as-seen-in/6.png" alt="Forbes logo" /></div>
  </div>
</section>

<style>
  .marquee-heading {
    text-align: center;
  }
</style>

<script>
  function initMarquee() {
    const track = document.querySelector('.marquee-track');
    if (!track) return;
    // Duplicate content for seamless infinite scroll
    track.innerHTML += track.innerHTML;
  }

  initMarquee();
  document.addEventListener('astro:after-swap', initMarquee);
</script>
