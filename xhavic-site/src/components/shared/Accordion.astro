---
/**
 * Accordion — Native details/summary FAQ-style accordion
 * Props:
 *   items — array of { question, answer } objects
 */
interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items: AccordionItem[];
}

const { items } = Astro.props;
---

<div class="accordion w-full divide-y divide-stroke/30">
  {items.map((item, i) => (
    <details class="accordion-item group" data-accordion-item>
      <summary class="accordion-trigger flex items-center justify-between gap-4 cursor-pointer py-5 px-1 list-none [&::-webkit-details-marker]:hidden">
        <span class="text-lg font-bold tracking-tight text-ink/90 group-hover:text-ink transition-colors">
          {item.question}
        </span>
        <span class="accordion-chevron flex-shrink-0 w-8 h-8 rounded-sm border border-stroke/40 bg-white grid place-items-center text-base text-ink/70 transition-all duration-200 group-open:bg-primary group-open:text-white group-open:border-transparent">
          <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M12 5v14M5 12h14" stroke-linecap="round" />
          </svg>
        </span>
      </summary>
      <div class="accordion-body pb-5 pr-12 pl-1">
        <p class="text-base text-muted leading-relaxed">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
