const currentPath = Astro.url.pathname;
---

<nav class="mobile-panel" aria-label="Mobile navigation">
  <div class="mobile-inner">
    <!-- Sections -->
    {sections.map((section, sIdx) => (
      <div class="mobile-section" style={`--stagger: ${sIdx}`}>
        <div class="mobile-section-title">{section.title}</div>
        <ul class="mobile-section-links">
          {section.links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'mobile-link',
                  { 'is-active': currentPath === link.href },
                ]}
                {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {link.label}
                {link.href.startsWith('http') ? (
                  <svg class="mobile-link-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M5 3H11V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                ) : (
                  <svg class="mobile-link-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Docs CTA -->
    <div class="mobile-docs" style="--stagger: 3">
      <a href="/docs" class="mobile-docs-btn" target="_blank" rel="noopener">
        Documentation
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M5 3H11V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <!-- Social links -->
    <div class="mobile-social" style="--stagger: 4">
      {socialLinks.map((link) => (
        <a href={link.href} class="mobile-social-link" target="_blank" rel="noopener" aria-label={link.label}>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d={link.icon} />
          </svg>
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
    if (!toggle) return;
    document.querySelectorAll('.mobile-link, .mobile-docs-btn').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.checked = false;
      });
    });
  });
</script>

<style>
  .mobile-panel {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.97);
    padding-top: 80px;
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
    z-index: 110;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  :global(#nav-toggle:checked) ~ .mobile-panel {
    transform: translateY(0);
  }

  .mobile-inner {
    padding: 20px 24px 40px;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Staggered entrance */
  .mobile-section,
  .mobile-docs,
  .mobile-social {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--stagger, 0) * 80ms + 100ms);
  }

  :global(#nav-toggle:checked) ~ .mobile-panel .mobile-section,
  :global(#nav-toggle:checked) ~ .mobile-panel .mobile-docs,
  :global(#nav-toggle:checked) ~ .mobile-panel .mobile-social {
    opacity: 1;
    transform: translateY(0);
  }

  /* Section */
  .mobile-section {
    margin-bottom: 28px;
  }

  .mobile-section-title {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.35);
    padding: 0 4px;
    margin-bottom: 10px;
  }

  .mobile-section-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 16px;
    padding: 14px 16px;
    border-radius: 14px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-link:hover,
  .mobile-link:active {
    background: rgba(255, 255, 255, 0.05);
  }

  .mobile-link.is-active {
    color: #2262ff;
    background: rgba(34, 98, 255, 0.08);
  }

  .mobile-link-arrow {
    opacity: 0.3;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .mobile-link:hover .mobile-link-arrow {
    opacity: 0.6;
    transform: translateX(2px);
  }

  /* Docs CTA */
  .mobile-docs {
    margin-bottom: 32px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mobile-docs-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(34, 98, 255, 0.3);
    background: rgba(34, 98, 255, 0.1);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .mobile-docs-btn:hover {
    background: rgba(34, 98, 255, 0.18);
    border-color: rgba(34, 98, 255, 0.5);
  }

  /* Social links */
  .mobile-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .mobile-social-link {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .mobile-social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
</style>
