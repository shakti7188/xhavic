---
interface Props {
  type:
    | 'Organization'
    | 'WebSite'
    | 'BreadcrumbList'
    | 'FAQPage'
    | 'Article'
    | 'SoftwareApplication'
    | 'HowTo'
    | 'DefinedTermSet';
  data: Record<string, any>;
}

const { type, data } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://xhavic.io';

/**
 * Build the full JSON-LD object by merging the @context and @type
 * with the user-provided data record.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type,
  ...data,
};

// Clean up undefined values so they don't appear as "null" in the output
function stripUndefined(obj: Record<string, any>): Record<string, any> {
  return JSON.parse(JSON.stringify(obj));
}

const cleanJsonLd = stripUndefined(jsonLd);
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(cleanJsonLd, null, 2)}
/>
