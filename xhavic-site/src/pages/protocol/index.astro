---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Protocol Overview — Xhavic"
  description="Optimistic rollup architecture, 6-layer modular design, Ethereum-settled security, progressive decentralization."
>

  <!-- ════════════════════════════════════════════════════════════════
       1. HERO — Dark, heading-display, SVG diagram, generous padding
       ════════════════════════════════════════════════════════════════ -->
  <section class="bg-dark text-white overflow-hidden py-24 md:py-36">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center min-h-[60vh]">

        <!-- Left: Copy -->
        <div class="max-w-xl" data-reveal>
          <h1 class="heading-display mb-6">
            <span class="gradient-text-static">How Xhavic</span><br />
            <span class="gradient-text-static">Works</span>
          </h1>
          <p class="prose-editorial-dark mb-10 max-w-lg">
            Xhavic is an Ethereum Layer-2 execution network built on optimistic rollup architecture.
            It processes transactions off-chain and settles the results on Ethereum, adding a third dimension
            no other L2 offers: protocol-level transaction risk routing.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/whitepaper" class="btn-primary">Read the Whitepaper</a>
            <a href="/protocol/architecture" class="btn-dark">View Architecture</a>
          </div>
        </div>

        <!-- Right: Stylized 6-Layer Stack SVG -->
        <div class="relative flex items-center justify-center" data-reveal>
          <svg viewBox="0 0 400 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-sm lg:max-w-md animate-float-slow">
            <!-- Layer 6 — Governance (top) -->
            <g opacity="0.55">
              <path d="M200 30 L350 85 L200 140 L50 85 Z" fill="url(#layer6)" stroke="rgba(34,98,255,0.3)" stroke-width="1"/>
              <text x="200" y="92" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="11" font-weight="600">GOVERNANCE</text>
            </g>
            <!-- Layer 5 — Oracle + AI -->
            <g opacity="0.62">
              <path d="M200 80 L350 135 L200 190 L50 135 Z" fill="url(#layer5)" stroke="rgba(34,98,255,0.35)" stroke-width="1"/>
              <text x="200" y="142" text-anchor="middle" fill="rgba(255,255,255,0.75)" font-size="11" font-weight="600">ORACLE + AI</text>
            </g>
            <!-- Layer 4 — Data Availability -->
            <g opacity="0.70">
              <path d="M200 130 L350 185 L200 240 L50 185 Z" fill="url(#layer4)" stroke="rgba(34,98,255,0.4)" stroke-width="1"/>
              <text x="200" y="192" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="11" font-weight="600">DATA AVAILABILITY</text>
            </g>
            <!-- Layer 3 — Settlement -->
            <g opacity="0.78">
              <path d="M200 180 L350 235 L200 290 L50 235 Z" fill="url(#layer3)" stroke="rgba(34,98,255,0.45)" stroke-width="1"/>
              <text x="200" y="242" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-size="11" font-weight="600">SETTLEMENT</text>
            </g>
            <!-- Layer 2 — Sequencing -->
            <g opacity="0.87">
              <path d="M200 230 L350 285 L200 340 L50 285 Z" fill="url(#layer2)" stroke="rgba(34,98,255,0.5)" stroke-width="1"/>
              <text x="200" y="292" text-anchor="middle" fill="rgba(255,255,255,0.9)" font-size="11" font-weight="600">SEQUENCING</text>
            </g>
            <!-- Layer 1 — Execution (bottom, strongest) -->
            <g opacity="1">
              <path d="M200 280 L350 335 L200 390 L50 335 Z" fill="url(#layer1)" stroke="rgba(34,98,255,0.6)" stroke-width="1.5"/>
              <text x="200" y="342" text-anchor="middle" fill="white" font-size="12" font-weight="700">EXECUTION</text>
            </g>
            <!-- Gradients -->
            <defs>
              <linearGradient id="layer1" x1="50" y1="280" x2="350" y2="390" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="rgba(34,98,255,0.25)"/>
                <stop offset="100%" stop-color="rgba(34,98,255,0.08)"/>
              </linearGradient>
              <linearGradient id="layer2" x1="50" y1="230" x2="350" y2="340" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="rgba(34,98,255,0.2)"/>
                <stop offset="100%" stop-color="rgba(34,98,255,0.06)"/>
              </linearGradient>
              <linearGradient id="layer3" x1="50" y1="180" x2="350" y2="290" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="rgba(34,98,255,0.17)"/>
                <stop offset="100%" stop-color="rgba(34,98,255,0.05)"/>
              </linearGradient>
              <linearGradient id="layer4" x1="50" y1="130" x2="350" y2="240" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="rgba(34,98,255,0.14)"/>
                <stop offset="100%" stop-color="rgba(34,98,255,0.04)"/>
              </linearGradient>
              <linearGradient id="layer5" x1="50" y1="80" x2="350" y2="190" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="rgba(34,98,255,0.11)"/>
                <stop offset="100%" stop-color="rgba(34,98,255,0.03)"/>
              </linearGradient>
              <linearGradient id="layer6" x1="50" y1="30" x2="350" y2="140" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="rgba(34,98,255,0.08)"/>
                <stop offset="100%" stop-color="rgba(34,98,255,0.02)"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>

    <!-- Floating stat cards overlaying hero bottom edge -->
    <div class="container relative z-10 -mb-16 mt-8">
      <div class="stats-strip" data-reveal-stagger>
        <div class="glass-card stat-item">
          <div class="stat-value"><span data-count-to="6">0</span></div>
          <div class="stat-label">Modular Layers</div>
        </div>
        <div class="glass-card stat-item">
          <div class="stat-value"><span data-count-to="120000" data-count-suffix="+">0</span></div>
          <div class="stat-label">Target TPS</div>
          <div class="stat-note">Phase IV sharding</div>
        </div>
        <div class="glass-card stat-item">
          <div class="stat-value"><span data-count-to="0.04" data-count-prefix="$">0</span></div>
          <div class="stat-label">Avg. Gas Cost</div>
          <div class="stat-note">Target at launch</div>
        </div>
        <div class="glass-card stat-item">
          <div class="stat-value">24h</div>
          <div class="stat-label">Reversal Window</div>
          <div class="stat-note">Secured Wallet</div>
        </div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════════
       2. WHAT IS XHAVIC — section-bordered + grid-40-60
       ════════════════════════════════════════════════════════════════ -->
  <section class="section-bordered pt-28" data-reveal>
    <div class="container">
      <div class="grid-40-60">
        <!-- Left: Label + heading -->
        <div>
          <span class="label-mono">01 — OVERVIEW</span>
          <h2 class="heading-section text-ink mt-4">
            What is Xhavic?
          </h2>
        </div>

        <!-- Right: Prose -->
        <div class="prose-editorial">
          <p class="mb-6">
            Xhavic is a Layer-2 rollup designed to scale Ethereum. It executes transactions off-chain
            and settles the results on Ethereum, enabling faster throughput and lower transaction costs
            without requiring changes to the underlying protocol.
          </p>

          <!-- Pull quote -->
          <blockquote class="border-l-4 border-primary pl-6 md:pl-8 py-4 my-10 md:my-14">
            <p class="text-xl md:text-2xl font-semibold text-ink leading-snug italic">
              "An Ethereum-settled execution network that separates fast composable DeFi
              from institutional-grade reversible settlement at the protocol level."
            </p>
            <cite class="block mt-4 text-sm text-muted not-italic font-medium">
              &mdash; XHAVIC Technical Whitepaper v1.0
            </cite>
          </blockquote>

          <p>
            With Xhavic, decentralized applications support higher usage, faster interactions, and more
            complex workflows while benefiting from Ethereum's security guarantees.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════════
       3. WHY ANOTHER L2 — section-bordered + section-number + grid-3 card-feature
       ════════════════════════════════════════════════════════════════ -->
  <section class="section-bordered section-numbered" data-reveal>
    <div class="container">
      <span class="section-number">02 — DIFFERENTIATORS</span>
      <h2 class="heading-section text-ink mb-4">
        Why Another L2?
      </h2>
      <p class="prose-editorial mb-12">
        Existing Layer-2 networks treat every transaction identically.
        Xhavic addresses three gaps no other L2 has solved.
      </p>

      <div class="grid-3" data-reveal-stagger>
        <!-- Card 1: Risk-Uniform Execution -->
        <div class="card-feature">
          <span class="card-number">01</span>
          <h3 class="heading-sub text-ink mb-3">Risk-Uniform Execution</h3>
          <p class="text-sm text-muted leading-relaxed">
            Every L2 processes a $50 token swap and a $5M treasury transfer through the same pipeline.
            Xhavic's Dual Wallet System routes them differently at the sequencer level.
            Instant Wallet for composable DeFi. Secured Wallet with 24-hour reversal for institutional operations.
          </p>
        </div>

        <!-- Card 2: Bolted-On Oracles -->
        <div class="card-feature">
          <span class="card-number">02</span>
          <h3 class="heading-sub text-ink mb-3">Bolted-On Oracles</h3>
          <p class="text-sm text-muted leading-relaxed">
            Most L2s depend on external oracle providers, adding latency and third-party risk.
            Xhavic provides native oracle infrastructure via precompile addresses.
          </p>
        </div>

        <!-- Card 3: No AI-Native Support -->
        <div class="card-feature">
          <span class="card-number">03</span>
          <h3 class="heading-sub text-ink mb-3">No AI-Native Support</h3>
          <p class="text-sm text-muted leading-relaxed">
            AI is treated as a dApp vertical on other chains. Xhavic enshrines AI agent execution
            as a protocol-level primitive with deterministic ordering and gas-metered compute.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════════
       4. THREE DIFFERENTIATORS — section-inset dark, split sections
       ════════════════════════════════════════════════════════════════ -->
  <section class="section-inset" data-reveal>
    <div class="container">
      <div class="text-center mb-16 md:mb-20">
        <span class="label-mono-dark">CORE ARCHITECTURE</span>
        <h2 class="heading-section mt-4">
          What Makes Xhavic Different
        </h2>
      </div>

      <!-- Differentiator 1: Dual Wallet System -->
      <div class="grid-40-60 mb-16 md:mb-24" data-reveal>
        <div>
          <span class="label-mono-dark">DIFFERENTIATOR 01</span>
          <h3 class="heading-sub mt-3 mb-4">Dual Wallet System</h3>
          <p class="prose-editorial-dark mb-6">
            Two execution paths separated at the sequencer level. Instant Wallet for composable DeFi.
            Secured Wallet with 24-hour reversal for institutional operations.
          </p>
          <a href="/protocol/dual-wallet" class="text-primary font-semibold text-sm hover:underline">
            Learn more &rarr;
          </a>
        </div>
        <div class="flex items-center justify-center">
          <svg viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-xs">
            <!-- Sequencer box -->
            <rect x="110" y="10" width="100" height="40" rx="10" fill="rgba(34,98,255,0.12)" stroke="rgba(34,98,255,0.4)" stroke-width="1.5"/>
            <text x="160" y="35" text-anchor="middle" fill="#2262ff" font-size="11" font-weight="700">SEQUENCER</text>
            <!-- Split lines -->
            <line x1="135" y1="50" x2="80" y2="100" stroke="rgba(34,98,255,0.3)" stroke-width="1.5" stroke-dasharray="4 3"/>
            <line x1="185" y1="50" x2="240" y2="100" stroke="rgba(34,98,255,0.3)" stroke-width="1.5" stroke-dasharray="4 3"/>
            <!-- Instant Wallet -->
            <rect x="20" y="100" width="120" height="60" rx="14" fill="rgba(34,98,255,0.08)" stroke="rgba(34,98,255,0.25)" stroke-width="1.5"/>
            <text x="80" y="125" text-anchor="middle" fill="#2262ff" font-size="10" font-weight="700">INSTANT</text>
            <text x="80" y="142" text-anchor="middle" fill="#667085" font-size="9">Composable DeFi</text>
            <!-- Secured Wallet -->
            <rect x="180" y="100" width="120" height="60" rx="14" fill="rgba(196,163,90,0.1)" stroke="rgba(196,163,90,0.35)" stroke-width="1.5"/>
            <text x="240" y="125" text-anchor="middle" fill="#c4a35a" font-size="10" font-weight="700">SECURED</text>
            <text x="240" y="142" text-anchor="middle" fill="#667085" font-size="9">24h Reversal</text>
            <!-- Ethereum settlement -->
            <line x1="80" y1="160" x2="160" y2="210" stroke="rgba(34,98,255,0.2)" stroke-width="1" stroke-dasharray="4 3"/>
            <line x1="240" y1="160" x2="160" y2="210" stroke="rgba(34,98,255,0.2)" stroke-width="1" stroke-dasharray="4 3"/>
            <rect x="110" y="195" width="100" height="35" rx="10" fill="rgba(34,98,255,0.05)" stroke="rgba(34,98,255,0.15)" stroke-width="1"/>
            <text x="160" y="217" text-anchor="middle" fill="#667085" font-size="10" font-weight="600">ETHEREUM L1</text>
          </svg>
        </div>
      </div>

      <hr class="hr-subtle-dark" />

      <!-- Differentiator 2: 6-Layer Architecture -->
      <div class="grid-40-60 my-16 md:my-24" data-reveal>
        <div>
          <span class="label-mono-dark">DIFFERENTIATOR 02</span>
          <h3 class="heading-sub mt-3 mb-4">6-Layer Modular Architecture</h3>
          <p class="prose-editorial-dark mb-6">
            Six independent layers — execution, sequencing, settlement, data availability,
            oracle + AI agents, governance — each independently upgradeable.
          </p>
          <a href="/protocol/architecture" class="text-primary font-semibold text-sm hover:underline">
            Learn more &rarr;
          </a>
        </div>
        <div class="flex items-center justify-center">
          <svg viewBox="0 0 280 260" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-xs">
            <rect x="20" y="10" width="240" height="32" rx="8" fill="rgba(34,98,255,0.05)" stroke="rgba(34,98,255,0.12)" stroke-width="1"/>
            <text x="140" y="31" text-anchor="middle" fill="#667085" font-size="10" font-weight="600">L6 &mdash; GOVERNANCE</text>
            <rect x="20" y="50" width="240" height="32" rx="8" fill="rgba(34,98,255,0.07)" stroke="rgba(34,98,255,0.16)" stroke-width="1"/>
            <text x="140" y="71" text-anchor="middle" fill="#667085" font-size="10" font-weight="600">L5 &mdash; ORACLE + AI</text>
            <rect x="20" y="90" width="240" height="32" rx="8" fill="rgba(34,98,255,0.09)" stroke="rgba(34,98,255,0.2)" stroke-width="1"/>
            <text x="140" y="111" text-anchor="middle" fill="#667085" font-size="10" font-weight="600">L4 &mdash; DATA AVAILABILITY</text>
            <rect x="20" y="130" width="240" height="32" rx="8" fill="rgba(34,98,255,0.11)" stroke="rgba(34,98,255,0.25)" stroke-width="1"/>
            <text x="140" y="151" text-anchor="middle" fill="#667085" font-size="10" font-weight="600">L3 &mdash; SETTLEMENT</text>
            <rect x="20" y="170" width="240" height="32" rx="8" fill="rgba(34,98,255,0.14)" stroke="rgba(34,98,255,0.3)" stroke-width="1"/>
            <text x="140" y="191" text-anchor="middle" fill="#667085" font-size="10" font-weight="600">L2 &mdash; SEQUENCING</text>
            <rect x="20" y="210" width="240" height="36" rx="8" fill="rgba(34,98,255,0.18)" stroke="rgba(34,98,255,0.4)" stroke-width="1.5"/>
            <text x="140" y="233" text-anchor="middle" fill="#2262ff" font-size="11" font-weight="700">L1 &mdash; EXECUTION</text>
          </svg>
        </div>
      </div>

      <hr class="hr-subtle-dark" />

      <!-- Differentiator 3: Native Oracle + AI Execution -->
      <div class="grid-40-60 mt-16 md:mt-24" data-reveal>
        <div>
          <span class="label-mono-dark">DIFFERENTIATOR 03</span>
          <h3 class="heading-sub mt-3 mb-4">Native Oracle + AI Execution</h3>
          <p class="prose-editorial-dark mb-6">
            Oracle data accessible via precompile addresses (0x00...F0-FF). AI agents execute with
            deterministic ordering, programmatic wallet control, and gas-metered compute.
          </p>
          <a href="/protocol/architecture" class="text-primary font-semibold text-sm hover:underline">
            Learn more &rarr;
          </a>
        </div>
        <div class="flex items-center justify-center">
          <svg viewBox="0 0 300 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-xs">
            <!-- Oracle node -->
            <circle cx="90" cy="80" r="45" fill="rgba(34,98,255,0.06)" stroke="rgba(34,98,255,0.25)" stroke-width="1.5"/>
            <text x="90" y="75" text-anchor="middle" fill="#2262ff" font-size="10" font-weight="700">ORACLE</text>
            <text x="90" y="90" text-anchor="middle" fill="#667085" font-size="8">Precompile</text>
            <!-- AI node -->
            <circle cx="210" cy="80" r="45" fill="rgba(99,102,241,0.06)" stroke="rgba(99,102,241,0.25)" stroke-width="1.5"/>
            <text x="210" y="75" text-anchor="middle" fill="#6366f1" font-size="10" font-weight="700">AI AGENT</text>
            <text x="210" y="90" text-anchor="middle" fill="#667085" font-size="8">Deterministic</text>
            <!-- Connection -->
            <line x1="135" y1="80" x2="165" y2="80" stroke="rgba(34,98,255,0.3)" stroke-width="1.5" stroke-dasharray="4 3"/>
            <!-- Execution layer -->
            <rect x="50" y="160" width="200" height="40" rx="12" fill="rgba(34,98,255,0.08)" stroke="rgba(34,98,255,0.2)" stroke-width="1"/>
            <text x="150" y="185" text-anchor="middle" fill="#2262ff" font-size="10" font-weight="600">EXECUTION LAYER</text>
            <!-- Connections down -->
            <line x1="90" y1="125" x2="120" y2="160" stroke="rgba(34,98,255,0.15)" stroke-width="1" stroke-dasharray="4 3"/>
            <line x1="210" y1="125" x2="180" y2="160" stroke="rgba(34,98,255,0.15)" stroke-width="1" stroke-dasharray="4 3"/>
          </svg>
        </div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════════
       5. DESIGN PHILOSOPHY — section-bordered, numbered timeline steps
       ════════════════════════════════════════════════════════════════ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="grid-40-60">
        <!-- Left: Header -->
        <div class="lg:sticky lg:top-30">
          <span class="label-mono">03 — PRINCIPLES</span>
          <h2 class="heading-section text-ink mt-4 mb-6">
            Design Philosophy
          </h2>
          <p class="prose-editorial">
            Five principles guide every protocol decision. Each one is non-negotiable
            and directly reflected in the architecture.
          </p>
        </div>

        <!-- Right: Numbered steps timeline -->
        <div class="space-y-8" data-reveal-stagger>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full border border-primary/30 flex items-center justify-center">
              <span class="label-mono text-primary" style="margin:0;font-size:12px;">01</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-1">Ethereum Alignment</h3>
              <p class="prose-editorial">
                Xhavic inherits security from Ethereum through settlement. It does not create an independent security model.
              </p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full border border-primary/30 flex items-center justify-center">
              <span class="label-mono text-primary" style="margin:0;font-size:12px;">02</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-1">Security Inheritance</h3>
              <p class="prose-editorial">
                State commitments posted to Ethereum, fraud proofs verified on L1, censorship resistance via forced inclusion.
              </p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full border border-primary/30 flex items-center justify-center">
              <span class="label-mono text-primary" style="margin:0;font-size:12px;">03</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-1">Modularity</h3>
              <p class="prose-editorial">
                Six independent layers, each upgradeable without affecting the others. No monolithic codebase.
              </p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full border border-primary/30 flex items-center justify-center">
              <span class="label-mono text-primary" style="margin:0;font-size:12px;">04</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-1">Progressive Decentralization</h3>
              <p class="prose-editorial">
                Phase I operates with a permissioned sequencer. Phase II introduces multi-sequencer and full DAO governance.
              </p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full border border-primary/30 flex items-center justify-center">
              <span class="label-mono text-primary" style="margin:0;font-size:12px;">05</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-1">Practical Focus</h3>
              <p class="prose-editorial">
                Features serve verifiable use cases. No speculative roadmap items presented as current capabilities.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════════════════════════════
       6. ROADMAP — Full-width bg-dark, horizontal timeline
       ════════════════════════════════════════════════════════════════ -->
  <section class="py-20 md:py-30 bg-dark text-white" data-reveal>
    <div class="container">
      <div class="text-center mb-14 md:mb-18">
        <span class="label-mono-dark">04 — TIMELINE</span>
        <h2 class="heading-section mt-4 mb-4">
          Development Timeline
        </h2>
        <p class="prose-editorial-dark mx-auto" style="text-align:center;">
          A phased approach to building, decentralizing, and scaling the network.
        </p>
      </div>

      <div class="timeline-horizontal" data-reveal-stagger>
        <!-- Phase I -->
        <div class="timeline-h-item px-3 md:px-4">
          <div class="card-dark-solid text-left mt-6 p-6">
            <div class="text-primary text-xs font-bold uppercase tracking-wider mb-1">Phase I</div>
            <div class="text-white/50 text-sm mb-3">Q1 &ndash; Q2 2026</div>
            <h3 class="text-lg font-bold mb-4 text-white">Foundation</h3>
            <ul class="space-y-2">
