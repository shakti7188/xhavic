---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/global/JsonLd.astro';

interface GlossaryTerm {
  term: string;
  definition: string;
}

interface GlossaryCategory {
  name: string;
  id: string;
  icon: string;
  terms: GlossaryTerm[];
}

const categories: GlossaryCategory[] = [
  {
    name: 'Protocol',
    id: 'protocol',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
    terms: [
      {
        term: 'Optimistic Rollup',
        definition: 'A Layer-2 scaling approach that executes transactions off-chain and posts results to Ethereum. Transactions are assumed valid unless challenged with a fraud proof during the challenge window.',
      },
      {
        term: 'Fraud Proof',
        definition: 'A cryptographic proof submitted to Ethereum that demonstrates a sequencer posted an incorrect state root. If verified, the invalid state is reverted and the sequencer is slashed.',
      },
      {
        term: 'State Root',
        definition: 'A cryptographic hash representing the complete state of the execution network at a given block height. State roots are committed to Ethereum for verification.',
      },
      {
        term: 'Challenge Window',
        definition: 'The 7-day period after a state root is posted to Ethereum during which any participant can submit a fraud proof. After this window closes without a valid challenge, the state is considered final.',
      },
      {
        term: 'Sequencer',
        definition: 'The entity responsible for ordering transactions, executing them on the EVM, and submitting batches to Ethereum. In the Alpha phase, Xhavic operates a single centralized sequencer managed by the Xhavic Foundation.',
      },
      {
        term: 'Batch',
        definition: 'A collection of transactions bundled by the sequencer and submitted to Ethereum as a single calldata payload. Xhavic submits batches every 60 seconds.',
      },
    ],
  },
  {
    name: 'Wallet',
    id: 'wallet',
    icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z',
    terms: [
      {
        term: 'Dual Wallet System',
        definition: 'Xhavic\'s protocol-level transaction routing mechanism. Two distinct execution paths — Instant Wallet and Secured Wallet — separated at the sequencer level, allowing users to choose between speed and reversibility.',
      },
      {
        term: 'Instant Wallet',
        definition: 'The fast execution path for composable DeFi operations. Transactions finalize with soft finality in 2-5 seconds and are irreversible once confirmed.',
      },
      {
        term: 'Secured Wallet',
        definition: 'The protected execution path for high-value or institutional operations. Transactions enter a 24-hour escrow period during which they can be reversed by the sender.',
      },
      {
        term: 'Escrow Period',
        definition: 'The 24-hour window during which Secured Wallet transactions are held in a protocol-managed escrow contract. The sender can initiate a reversal before the period expires.',
      },
    ],
  },
  {
    name: 'Security',
    id: 'security',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    terms: [
      {
        term: 'Slashing',
        definition: 'The penalty mechanism for sequencers that submit invalid state roots. A portion of the sequencer\'s staked collateral is burned, and the remaining portion is awarded to the fraud proof submitter.',
      },
      {
        term: 'Validator',
        definition: 'An entity that monitors sequencer output and verifies state transitions. Validators can submit fraud proofs if they detect an incorrect state root.',
      },
      {
        term: 'Interactive Bisection',
        definition: 'The fraud proof resolution protocol. The challenger and sequencer iteratively narrow down the disputed computation to a single instruction, which is then verified on Ethereum.',
      },
      {
        term: 'Single Honest Participant',
        definition: 'The security assumption underlying optimistic rollups. The system remains secure as long as at least one honest validator is monitoring the sequencer and is willing to submit fraud proofs.',
      },
    ],
  },
  {
    name: 'Infrastructure',
    id: 'infrastructure',
    icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
    terms: [
      {
        term: 'EVM Compatibility',
        definition: 'Full bytecode-level compatibility with the Ethereum Virtual Machine. Solidity and Vyper contracts deploy on Xhavic without modification. All Ethereum opcodes are supported.',
      },
      {
        term: 'Precompile',
        definition: 'A contract at a predefined address that executes native code instead of EVM bytecode. Xhavic uses precompile addresses (0x00...F0-FF) for oracle data access.',
      },
      {
        term: 'Gas',
        definition: 'The unit of computational cost for executing operations on the network. Xhavic gas costs are approximately 90% lower than Ethereum L1 for equivalent operations.',
      },
      {
        term: 'Data Availability',
        definition: 'The guarantee that transaction data is published and accessible so that any participant can reconstruct the full chain state and verify state transitions.',
      },
      {
        term: 'Calldata',
        definition: 'The Ethereum transaction field used to post Layer-2 batch data. Calldata is permanently stored on Ethereum and serves as the data availability layer for fraud proof verification.',
      },
    ],
  },
];

// Flatten all terms for JSON-LD
const allTerms = categories.flatMap((cat) =>
  cat.terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition,
  }))
);
---

<BaseLayout
  title="Glossary — Xhavic"
  description="Definitions for key protocol terminology used across Xhavic documentation, including rollup mechanics, wallet types, security primitives, and infrastructure concepts."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Reference</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">Glossary</h1>
        <p class="prose-editorial-dark">
          Definitions for key protocol terminology used across the Xhavic ecosystem.
        </p>
      </div>
    </div>
  </section>

  <!-- Glossary Terms -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <!-- Category Navigation -->
      <nav style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:3rem;">
        {categories.map((cat) => (
          <a
            href={`#${cat.id}`}
            style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;border-radius:8px;border:1px solid #e5e5e5;font-size:13px;font-weight:600;color:#171717;text-decoration:none;"
          >
            {cat.name}
            <span style="font-size:11px;color:#a3a3a3;">({cat.terms.length})</span>
          </a>
        ))}
      </nav>

      {categories.map((cat) => (
        <div id={cat.id} style="margin-bottom:3rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;">
            <span class="label-mono">{cat.name}</span>
          </div>
          <hr class="hr-subtle" style="margin-top:0;margin-bottom:1.5rem;" />
          <dl style="display:flex;flex-direction:column;gap:1.5rem;" data-reveal-stagger>
            {cat.terms.map((item) => (
              <div style="padding-bottom:1.5rem;border-bottom:1px solid #f5f5f5;">
                <dt style="font-weight:700;font-size:16px;margin-bottom:0.5rem;">{item.term}</dt>
                <dd style="font-size:15px;color:#737373;line-height:1.7;margin:0;">{item.definition}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </div>

  <!-- DefinedTermSet JSON-LD -->
  <JsonLd
    type="DefinedTermSet"
    data={{
      name: 'Xhavic Protocol Glossary',
      description: 'Key terminology and definitions for the Xhavic execution network.',
      hasDefinedTerm: allTerms,
    }}
  />

  <script>
    import '../scripts/reveal.ts';
  </script>
</BaseLayout>
