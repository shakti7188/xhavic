---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Enterprises — Xhavic"
  description="Protocol-level transaction safety for institutional operations. Secured Wallet with 24-hour reversal, RWA-ready architecture, and Ethereum-settled finality."
>
  <!-- ============================================================
       1. HERO — bg-dark, gold accent line above heading, shield SVG
       ============================================================ -->
  <section class="bg-dark text-white pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="container">
      <div class="grid-40-60" style="align-items: center;">
        <!-- Left: Copy -->
        <div class="max-w-2xl">
          <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="text-gray-600">/</span>
            <span class="text-white font-medium">Enterprises</span>
          </nav>

          <div class="w-16 h-[3px] mb-6" style="background: #c4a35a;"></div>

          <h1 class="heading-display text-white mb-6">
            Protocol-level transaction safety<br />
            <span>for institutional operations</span>
          </h1>

          <p class="prose-editorial-dark mb-10 max-w-xl">
            Xhavic's Secured Wallet provides a 24-hour reversal window for high-value transactions,
            enforced at the sequencer level. This is infrastructure, not a dApp feature.
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="#contact" class="btn-primary">Request Technical Brief</a>
            <a href="/protocol/dual-wallet" class="btn-dark">Dual Wallet System</a>
          </div>
        </div>

        <!-- Right: Enterprise Transaction Flow Graphic -->
        <div class="ent-hero-graphic">
          <!-- Outer frame -->
          <div class="ent-frame">
            <!-- Shield badge -->
            <div class="ent-shield-badge">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>

            <!-- Transaction flow cards -->
            <div class="ent-flow">
              <!-- Step 1: Initiate -->
              <div class="ent-flow-card" style="--delay: 0.1s;">
                <div class="ent-flow-num">01</div>
                <div class="ent-flow-label">Transaction Initiated</div>
                <div class="ent-flow-meta">Secured Wallet · Multi-sig</div>
                <div class="ent-flow-bar">
                  <div class="ent-flow-bar-fill" style="width: 100%;"></div>
                </div>
              </div>

              <!-- Connector -->
              <div class="ent-connector">
                <svg width="2" height="20" viewBox="0 0 2 20">
                  <line x1="1" y1="0" x2="1" y2="20" stroke="rgba(196,163,90,0.3)" stroke-width="1" stroke-dasharray="3 3" />
                </svg>
              </div>

              <!-- Step 2: Escrow -->
              <div class="ent-flow-card ent-flow-active" style="--delay: 0.3s;">
                <div class="ent-flow-num">02</div>
                <div class="ent-flow-label">24h Escrow Period</div>
                <div class="ent-flow-meta">Reversible · Provisional state</div>
                <div class="ent-flow-bar">
                  <div class="ent-flow-bar-fill ent-bar-animate" style="width: 65%;"></div>
                </div>
                <div class="ent-flow-timer">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  <span>15h 42m remaining</span>
                </div>
              </div>

              <!-- Connector -->
              <div class="ent-connector">
                <svg width="2" height="20" viewBox="0 0 2 20">
                  <line x1="1" y1="0" x2="1" y2="20" stroke="rgba(196,163,90,0.15)" stroke-width="1" stroke-dasharray="3 3" />
                </svg>
              </div>

              <!-- Step 3: Settled -->
              <div class="ent-flow-card ent-flow-pending" style="--delay: 0.5s;">
                <div class="ent-flow-num">03</div>
                <div class="ent-flow-label">Settled to Ethereum</div>
                <div class="ent-flow-meta">Immutable · L1 finality</div>
                <div class="ent-flow-bar">
                  <div class="ent-flow-bar-fill" style="width: 0%;"></div>
                </div>
              </div>
            </div>

            <!-- Stats strip -->
            <div class="ent-stats">
              <div class="ent-stat">
                <div class="ent-stat-val">$2.4M</div>
                <div class="ent-stat-label">Protected Value</div>
              </div>
              <div class="ent-stat-divider"></div>
              <div class="ent-stat">
                <div class="ent-stat-val">3/5</div>
                <div class="ent-stat-label">Signers Approved</div>
              </div>
              <div class="ent-stat-divider"></div>
              <div class="ent-stat">
                <div class="ent-stat-val">0</div>
                <div class="ent-stat-label">Reversals</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TRANSACTION SAFETY — section-bordered + grid-40-60
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="grid-40-60">
        <!-- Left: heading + copy -->
        <div>
          <p class="label-mono mb-3">TRANSACTION SAFETY</p>
          <h2 class="heading-section text-ink mb-4">Transaction Reversal at the Protocol Level</h2>
          <p class="prose-editorial">
            The Secured Wallet creates a 24-hour escrow period for every transaction.
            During this window, authorized signers can reverse the operation.
          </p>
        </div>

        <!-- Right: How it works + properties -->
        <div>
          <h3 class="heading-sub text-ink mb-6">How It Works</h3>
          <div class="space-y-5 text-muted leading-relaxed mb-8">
            <p>
              When a transaction originates from a Secured Wallet, the sequencer routes it into
              a 24-hour escrow period. The state change is provisional — visible but not finalized.
            </p>
            <p>
              During the escrow window, the transaction can be reversed by a multi-signature
              or threshold signature operation from the wallet's authorized signers.
            </p>
            <p>
              After 24 hours without reversal, the transaction finalizes and settles to Ethereum
              like any other transaction.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3. OPERATIONAL PROPERTIES — section-bordered, data-table
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="grid-35-65">
        <div>
          <p class="label-mono mb-3">SPECIFICATIONS</p>
          <h2 class="heading-section text-ink">Operational Properties</h2>
        </div>

        <div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Property</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Escrow Period</td>
                <td class="font-semibold text-ink">24 hours</td>
              </tr>
              <tr>
                <td>Reversal Mechanism</td>
                <td class="font-semibold text-ink">Multi-sig / threshold</td>
              </tr>
              <tr>
                <td>Composability</td>
                <td class="font-semibold text-ink">Non-composable until final</td>
              </tr>
              <tr>
                <td>Settlement</td>
                <td class="font-semibold text-ink">Ethereum (after escrow)</td>
              </tr>
              <tr>
                <td>Enforcement</td>
                <td class="font-semibold text-ink">Sequencer-level</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4. RWA INFRASTRUCTURE — section-inset dark, four card-dark-solid
       ============================================================ -->
  <section class="section-inset" data-reveal>
    <div class="container">
      <div class="text-center mb-12">
        <p class="label-mono-dark mb-3">INFRASTRUCTURE</p>
        <h2 class="heading-section text-white mb-4">RWA-Ready Infrastructure</h2>
        <p class="prose-editorial-dark mx-auto">
          Real-world asset tokenization requires infrastructure properties that most L2s lack.
          Xhavic's architecture addresses these requirements at the protocol level.
        </p>
      </div>

      <div class="grid-2" data-reveal-stagger>
        <!-- Transaction Reversibility -->
        <div class="card-dark-solid heading-accent-gold" style="padding: 2.5rem;">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background: rgba(196,163,90,0.15);">
              <svg class="w-5 h-5" style="color: #c4a35a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold mb-2 text-white">Transaction Reversibility</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                RWA operations often require reversal capabilities for error correction and dispute resolution.
                The Secured Wallet provides this natively without custom smart contract logic.
              </p>
            </div>
          </div>
        </div>

        <!-- Native Oracle Data -->
        <div class="card-dark-solid" style="padding: 2.5rem;">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold mb-2 text-white">Native Oracle Data</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                Asset pricing, reference rates, and external data are available via precompile addresses.
                No dependency on external oracle providers or their uptime.
              </p>
            </div>
          </div>
        </div>

        <!-- Ethereum Settlement -->
        <div class="card-dark-solid" style="padding: 2.5rem;">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold mb-2 text-white">Ethereum Settlement</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                State commits to Ethereum L1, providing the strongest available settlement guarantee.
                Institutional counterparties inherit Ethereum security.
              </p>
            </div>
          </div>
        </div>

        <!-- Deterministic Execution -->
        <div class="card-dark-solid" style="padding: 2.5rem;">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold mb-2 text-white">Deterministic Execution</h3>
              <p class="text-gray-400 text-sm leading-relaxed">
                EVM bytecode compatibility means identical state transitions across all validators.
                Audit trails are cryptographically verifiable.
              </p>
            </div>
          </div>
        </div>
      </div>

      <p class="footnote text-center mt-8" style="color: rgba(255,255,255,0.4);">
        Note: Xhavic provides infrastructure primitives. It does not provide regulatory compliance,
        legal opinions, or jurisdiction-specific guarantees. Compliance is the responsibility of
        the application layer.
      </p>
    </div>
  </section>

  <!-- ============================================================
       5. STATS — section-bordered, stats strip
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="mb-10">
        <p class="label-mono mb-2">PERFORMANCE</p>
        <h2 class="heading-section text-ink">Network Performance</h2>
      </div>

      <div class="stats-strip" data-reveal-stagger style="background: #000; border-radius: 16px; padding: 2rem;">
        <div class="stat-item">
          <div class="stat-value">
            <span data-count-to="2000" data-count-suffix="+">0</span>
          </div>
          <div class="stat-label">Transactions per second</div>
          <div class="stat-note">(Phase I target)</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">
            <span data-count-to="0.04" data-count-prefix="$">0</span>
          </div>
          <div class="stat-label">Average transaction cost</div>
          <div class="stat-note">(estimated at launch)</div>
        </div>
        <div class="stat-item">
          <div class="stat-value text-white">&lt;200ms</div>
          <div class="stat-label">Soft finality</div>
          <div class="stat-note">(Instant Wallet)</div>
        </div>
        <div class="stat-item">
          <div class="stat-value text-white">L1</div>
          <div class="stat-label">Ethereum settlement</div>
          <div class="stat-note">(~13 min finality)</div>
        </div>
      </div>
      <p class="text-center text-xs text-muted italic mt-4">
        Source: XHAVIC Technical Whitepaper v1.0, Table 1. Performance figures are targets for Phase I and subject to network conditions.
      </p>
    </div>
  </section>

  <!-- ============================================================
       6. USE CASES — section-bordered, three card-feature
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="mb-10">
        <p class="label-mono mb-2">USE CASES</p>
        <h2 class="heading-section text-ink mb-3">Institutional Use Cases</h2>
        <p class="prose-editorial">
          The Dual Wallet System and native oracle infrastructure enable operational patterns
          that are impractical on other L2 networks.
        </p>
      </div>

      <div class="grid-2" data-reveal-stagger>
        <div class="card-feature">
          <span class="card-number">01</span>
          <h3 class="heading-sub text-ink mb-3">Treasury Management</h3>
          <p class="text-muted text-sm leading-relaxed">
            Secured Wallet transactions with 24-hour reversal for disbursements, payroll,
            and cross-entity transfers. Multi-sig authorization enforced at protocol level.
          </p>
        </div>
        <div class="card-feature">
          <span class="card-number">02</span>
          <h3 class="heading-sub text-ink mb-3">RWA Tokenization</h3>
          <p class="text-muted text-sm leading-relaxed">
            Asset issuance and transfer with native oracle pricing, reversible settlement for
            error correction, and cryptographically verifiable audit trails.
          </p>
        </div>
        <div class="card-feature">
          <span class="card-number">03</span>
          <h3 class="heading-sub text-ink mb-3">Institutional DeFi</h3>
          <p class="text-muted text-sm leading-relaxed">
            Lending, borrowing, and yield operations using the Instant Wallet for composable
            DeFi interactions, with the Secured Wallet for position management.
          </p>
        </div>
        <div class="card-feature">
          <span class="card-number">04</span>
          <h3 class="heading-sub text-ink mb-3">Operational Workflows</h3>
          <p class="text-muted text-sm leading-relaxed">
            Multi-step business processes encoded as smart contracts with appropriate risk routing
            per step — fast execution for routine operations, secured paths for high-value steps.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       7. INTEGRATION PATH — section-bordered, numbered timeline
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="grid-40-60">
        <div>
          <p class="label-mono mb-3">GETTING STARTED</p>
          <h2 class="heading-section text-ink mb-4">Integration Path</h2>
          <p class="prose-editorial">
            From initial contact to production deployment.
          </p>
        </div>

        <div class="section-numbered" data-reveal-stagger>
          <div class="flex items-start gap-5 mb-8 pb-8" style="border-bottom: 1px solid #e5e5e5;">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">1</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Technical Brief</h3>
              <p class="text-muted leading-relaxed">
                Receive the detailed technical specification covering architecture, security model,
                and performance characteristics relevant to your use case.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-5 mb-8 pb-8" style="border-bottom: 1px solid #e5e5e5;">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">2</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Architecture Review</h3>
              <p class="text-muted leading-relaxed">
                Work with the Xhavic team to map your operational requirements to the protocol
                architecture. Identify which wallet types, oracle integrations, and execution patterns apply.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-5 mb-8 pb-8" style="border-bottom: 1px solid #e5e5e5;">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">3</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Testnet Deployment</h3>
              <p class="text-muted leading-relaxed">
                Deploy and test on the Xhavic testnet. Verify contract behavior, Dual Wallet interactions,
                oracle data feeds, and settlement timing against your requirements.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-5">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">4</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Production</h3>
              <p class="text-muted leading-relaxed">
                Deploy to mainnet with monitoring, alerting, and operational runbooks. The same contracts,
                addresses, and tooling from testnet apply to production.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       8. CTA — bg-dark centered
       ============================================================ -->
  <section class="bg-dark text-white py-20 md:py-28" data-reveal>
    <div class="container text-center">
      <h2 class="heading-display text-white mb-5">Explore the Protocol</h2>
      <p class="prose-editorial-dark mx-auto mb-10">
        Review the technical architecture, security model, and Dual Wallet specification
        in the full protocol documentation.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/protocol" class="btn-primary">Protocol Overview</a>
        <a href="/protocol/dual-wallet" class="btn-dark">Dual Wallet System &rarr;</a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/reveal.ts';
    import '../scripts/counter.ts';
  </script>

  <style>
    /* ========== Enterprise Hero Graphic ========== */
    .ent-hero-graphic {
      display: none;
    }

    @media (min-width: 1024px) {
      .ent-hero-graphic {
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }

    .ent-frame {
      position: relative;
      width: 100%;
      max-width: 420px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 32px 28px 24px;
      backdrop-filter: blur(8px);
    }

    /* Shield badge — top-right corner */
    .ent-shield-badge {
      position: absolute;
      top: -14px;
      right: 24px;
      width: 40px;
      height: 40px;
      background: rgba(196, 163, 90, 0.12);
      border: 1px solid rgba(196, 163, 90, 0.25);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #c4a35a;
    }

    /* Transaction flow */
    .ent-flow {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .ent-connector {
      display: flex;
      justify-content: center;
      padding: 2px 0;
    }

    .ent-flow-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      padding: 16px 18px;
      opacity: 0;
      transform: translateY(12px);
      animation: ent-card-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: var(--delay, 0s);
    }

    @keyframes ent-card-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .ent-flow-card.ent-flow-active {
      border-color: rgba(196, 163, 90, 0.25);
      background: rgba(196, 163, 90, 0.05);
    }

    .ent-flow-card.ent-flow-pending {
      opacity: 0;
      animation: ent-card-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .ent-flow-card.ent-flow-pending .ent-flow-label,
    .ent-flow-card.ent-flow-pending .ent-flow-meta {
      opacity: 0.35;
    }

    .ent-flow-num {
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      font-size: 10px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.25);
      letter-spacing: 0.08em;
      margin-bottom: 6px;
    }

    .ent-flow-active .ent-flow-num {
      color: #c4a35a;
    }

    .ent-flow-label {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 2px;
    }

    .ent-flow-meta {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.4);
      margin-bottom: 10px;
    }

    /* Progress bar */
    .ent-flow-bar {
      height: 3px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 2px;
      overflow: hidden;
    }

    .ent-flow-bar-fill {
      height: 100%;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.15);
      transition: width 0.6s ease;
    }

    .ent-flow-active .ent-flow-bar-fill {
      background: linear-gradient(90deg, #c4a35a, rgba(196, 163, 90, 0.5));
    }

    .ent-bar-animate {
      animation: ent-bar-grow 2s ease-in-out infinite alternate;
    }

