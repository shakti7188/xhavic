---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Xhavic"
  description="The requested page could not be found."
>
  <section class="min-h-[85vh] flex items-center justify-center bg-dark gradient-mesh relative overflow-hidden">
    <!-- Floating dots -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[15%] left-[10%] w-2 h-2 rounded-full bg-primary/20 animate-float" style="animation-delay: 0s;"></div>
      <div class="absolute top-[25%] right-[15%] w-3 h-3 rounded-full bg-primary/15 animate-float" style="animation-delay: 1.2s;"></div>
      <div class="absolute bottom-[30%] left-[20%] w-2.5 h-2.5 rounded-full bg-primary/10 animate-float-slow" style="animation-delay: 0.6s;"></div>
      <div class="absolute top-[60%] right-[25%] w-1.5 h-1.5 rounded-full bg-primary/25 animate-float" style="animation-delay: 2s;"></div>
      <div class="absolute top-[40%] left-[45%] w-2 h-2 rounded-full bg-primary/15 animate-float-slow" style="animation-delay: 0.3s;"></div>
      <div class="absolute bottom-[20%] right-[35%] w-3 h-3 rounded-full bg-primary/10 animate-float" style="animation-delay: 1.5s;"></div>
      <div class="absolute top-[10%] left-[60%] w-1.5 h-1.5 rounded-full bg-primary/20 animate-float-slow" style="animation-delay: 0.8s;"></div>
      <div class="absolute bottom-[15%] left-[70%] w-2 h-2 rounded-full bg-primary/15 animate-float" style="animation-delay: 2.5s;"></div>
      <div class="absolute top-[70%] left-[5%] w-2 h-2 rounded-full bg-white/5 animate-float-slow" style="animation-delay: 1.8s;"></div>
      <div class="absolute top-[20%] right-[40%] w-1.5 h-1.5 rounded-full bg-white/5 animate-float" style="animation-delay: 0.9s;"></div>
    </div>

    <div class="container text-center relative z-10">
      <div class="max-w-lg mx-auto">
        <p class="text-[10rem] md:text-[14rem] lg:text-[18rem] font-extrabold leading-none select-none mb-0 gradient-text-static" style="line-height: 0.85;">
          404
        </p>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4 -mt-4 md:-mt-6">
          Page not found
        </h1>
        <p class="text-gray-400 text-lg mb-10 max-w-sm mx-auto leading-relaxed">
          The page you requested does not exist or has been moved.
        </p>
        <a href="/" class="btn-primary">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/reveal.ts';
  </script>
</BaseLayout>
