---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Xhavic"
  description="The requested page could not be found."
>
  <section class="bg-dark text-white" style="min-height:90vh;display:flex;align-items:center;justify-content:center;" data-reveal>
    <div class="container" style="text-align:center;">
      <div style="max-width:480px;margin:0 auto;">
        <p style="font-family:var(--font-mono, 'SF Mono', Monaco, 'Cascadia Code', monospace);font-size:clamp(6rem,20vw,12rem);font-weight:800;line-height:1;letter-spacing:-0.04em;color:rgba(255,255,255,0.08);margin-bottom:1rem;user-select:none;">
          404
        </p>
        <h1 style="font-size:24px;font-weight:700;margin-bottom:0.75rem;">
          Page not found
        </h1>
        <p style="font-size:16px;color:rgba(255,255,255,0.4);margin-bottom:2.5rem;line-height:1.6;">
          The page you requested does not exist or has been moved.
        </p>
        <a href="/" class="btn-primary">
          Back to Home
        </a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/reveal.ts';
  </script>
</BaseLayout>
