---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Documentation — Xhavic"
  description="Xhavic platform launch is coming soon. Stay tuned for the full developer documentation and tools."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container" style="text-align:center;">
      <p class="label-mono-dark" style="margin-bottom:1.5rem;">Documentation</p>
      <h1 class="heading-display" style="margin-bottom:1.5rem;">Coming Soon</h1>
      <p class="prose-editorial-dark" style="margin-left:auto;margin-right:auto;">
        The Xhavic platform is under active development. Full documentation, developer tools, and the mainnet launch are on the way.
      </p>
    </div>
  </section>

  <!-- Routing Cards — light section -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono" style="margin-bottom:1rem;">Get Started</p>
      <h2 class="heading-section" style="margin-bottom:3rem;">Choose Your Path</h2>

      <div class="grid-3" data-reveal-stagger>
        <a href="/users" class="card-arch" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;">
          <p class="label-mono" style="margin-bottom:1rem;">01</p>
          <h3 style="font-size:20px;font-weight:700;margin-bottom:0.75rem;color:#171717;">Users</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;flex:1;">
            Get started with Xhavic. Set up your wallet, bridge assets, and explore the network.
          </p>
          <span style="display:block;margin-top:1.5rem;color:#2262ff;font-size:14px;font-weight:600;">Coming soon &rarr;</span>
        </a>
        <a href="/developers" class="card-arch" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;">
          <p class="label-mono" style="margin-bottom:1rem;">02</p>
          <h3 style="font-size:20px;font-weight:700;margin-bottom:0.75rem;color:#171717;">Developers</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;flex:1;">
            Deploy contracts, integrate with the oracle layer, and build on the Dual Wallet System.
          </p>
          <span style="display:block;margin-top:1.5rem;color:#2262ff;font-size:14px;font-weight:600;">Developers &rarr;</span>
        </a>
        <a href="/whitepaper" class="card-arch" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;">
          <p class="label-mono" style="margin-bottom:1rem;">03</p>
          <h3 style="font-size:20px;font-weight:700;margin-bottom:0.75rem;color:#171717;">Enterprises</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;flex:1;">
            Institutional integration, compliance modules, and enterprise-grade settlement.
          </p>
          <span style="display:block;margin-top:1.5rem;color:#2262ff;font-size:14px;font-weight:600;">Read the Whitepaper &rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- CTA — rounded inset for visual separation -->
  <section style="padding:2rem 0 4rem;">
    <div class="section-inset" data-reveal>
      <div style="text-align:center;max-width:580px;margin:0 auto;">
        <h2 class="heading-section" style="margin-bottom:1rem;">Start Building Today</h2>
        <p class="prose-editorial-dark" style="margin-left:auto;margin-right:auto;margin-bottom:2rem;">
          While full documentation is in progress, explore the developer resources available now.
        </p>
        <a href="/developers" class="btn-primary">Developer Resources</a>
      </div>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
</BaseLayout>
