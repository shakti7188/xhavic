---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Launch — Xhavic"
  description="Xhavic platform launch is coming soon. Stay tuned for the full developer documentation and tools."
>
  <!-- Coming Soon Hero -->
  <section class="bg-dark text-white min-h-[80vh] flex items-center justify-center">
    <div class="container text-center">
      <div class="max-w-2xl mx-auto">
        <div class="w-20 h-20 rounded-3xl bg-primary/10 flex items-center justify-center mx-auto mb-10">
          <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold mb-6 tracking-tight">
          <span class="gradient-text-static">Coming Soon</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-400 max-w-xl mx-auto leading-relaxed mb-10">
          The Xhavic platform is under active development. Full documentation, developer tools, and the mainnet launch are on the way.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/developers" class="btn-primary">Developers &rarr;</a>
          <a href="/whitepaper" class="btn-secondary">Read the Whitepaper</a>
        </div>
      </div>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
</BaseLayout>
