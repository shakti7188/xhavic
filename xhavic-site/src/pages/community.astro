---
import BaseLayout from '@/layouts/BaseLayout.astro';

/* Community numbers are dummy for now — flip to true when real data is available */
const showCommunityNumbers = false;
---

<BaseLayout
  title="Community — Xhavic"
  description="Join the Xhavic community. Connect on Discord, Telegram, Twitter/X, GitHub, and LinkedIn. Contribute to the protocol, documentation, testing, and ecosystem."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Community</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">
          Join the Xhavic<br />community
        </h1>
        <p class="prose-editorial-dark">
          Xhavic is built in public. Follow development progress, participate in governance
          discussions, report issues, and contribute to the protocol and its ecosystem.
        </p>
      </div>
    </div>
  </section>

  <!-- Channels -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono" style="margin-bottom:1rem;">Connect</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Channels</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        Official channels for discussion, announcements, and support.
      </p>
      <div class="grid-3" data-reveal-stagger>
        <!-- Discord (Coming Soon) -->
        <a href="#" class="card-arch" style="text-decoration:none;color:inherit;opacity:0.5;pointer-events:none;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:20px;height:20px;color:#5865F2;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">Discord <span style="font-size:11px;color:#a3a3a3;font-weight:500;">(Coming Soon)</span></h3>
          <p style="font-size:14px;color:#737373;">Technical discussion, support, and community chat</p>
        </a>

        <!-- Telegram -->
        <a href="https://t.me/Xhaviccommunity" class="card-arch" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:20px;height:20px;color:#0088cc;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">Telegram</h3>
          <p style="font-size:14px;color:#737373;">Announcements and community updates</p>
        </a>

        <!-- Twitter/X -->
        <a href="https://x.com/XhavicLabs" class="card-arch" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:18px;height:18px;color:#000;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">Twitter / X</h3>
          <p style="font-size:14px;color:#737373;">Protocol updates and ecosystem news</p>
        </a>

        <!-- YouTube -->
        <a href="https://youtube.com/@xhavichain" class="card-arch" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#ff00001a;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:18px;height:18px;color:#ff0000;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">YouTube</h3>
          <p style="font-size:14px;color:#737373;">Video content, demos, and tutorials</p>
        </a>

        <!-- GitHub (Coming Soon) -->
        <a href="#" class="card-arch" style="text-decoration:none;color:inherit;opacity:0.5;pointer-events:none;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:20px;height:20px;color:#000;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">GitHub <span style="font-size:11px;color:#a3a3a3;font-weight:500;">(Coming Soon)</span></h3>
          <p style="font-size:14px;color:#737373;">Source code, issues, and contributions</p>
        </a>

        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/company/xhavic/" class="card-arch" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:18px;height:18px;color:#0A66C2;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">LinkedIn</h3>
          <p style="font-size:14px;color:#737373;">Professional updates and team posts</p>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/xhavicofficial/" class="card-arch" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:20px;height:20px;color:#E4405F;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">Instagram</h3>
          <p style="font-size:14px;color:#737373;">Visual updates and behind-the-scenes</p>
        </a>

        <!-- Facebook -->
        <a href="https://www.facebook.com/profile.php?id=61587340254751" class="card-arch" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:20px;height:20px;color:#1877F2;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">Facebook</h3>
          <p style="font-size:14px;color:#737373;">Connect with us and stay in the loop</p>
        </a>

        <!-- Forum / Governance -->
        <a href="/docs" class="card-arch" style="text-decoration:none;color:inherit;">
          <div style="width:40px;height:40px;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
            <svg style="width:20px;height:20px;color:#2262ff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">Governance Forum</h3>
          <p style="font-size:14px;color:#737373;">Proposals, discussions, and protocol decisions</p>
        </a>
      </div>
    </div>
  </div>

  <!-- Contribute -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono" style="margin-bottom:1rem;">Participate</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Ways to Contribute</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        Xhavic development benefits from contributions at every level.
        Technical and non-technical contributions are both valuable.
      </p>
      <div class="grid-2" data-reveal-stagger>
        <div class="card-feature">
          <span class="card-number">01</span>
          <h3 style="font-size:18px;font-weight:700;margin-bottom:0.5rem;">Core Protocol</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;margin-bottom:1rem;">
            Contribute to the protocol implementation. Execution layer, sequencer, settlement,
            oracle infrastructure, and governance contracts are all open for contributions.
          </p>
          <span style="color:#d97706;font-size:14px;font-weight:600;">GitHub — Coming Soon</span>
        </div>
        <div class="card-feature">
          <span class="card-number">02</span>
          <h3 style="font-size:18px;font-weight:700;margin-bottom:0.5rem;">Documentation</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;margin-bottom:1rem;">
            Improve developer guides, API reference documentation, tutorials, and
            integration examples. Clear documentation accelerates ecosystem growth.
          </p>
          <a href="/docs" style="color:#2262ff;font-size:14px;font-weight:600;text-decoration:none;">Documentation &rarr;</a>
        </div>
        <div class="card-feature">
          <span class="card-number">03</span>
          <h3 style="font-size:18px;font-weight:700;margin-bottom:0.5rem;">Testing &amp; Security</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;margin-bottom:1rem;">
            Run testnet nodes, report bugs, write test cases, and participate in security
            review. The testnet is open for anyone to deploy and test applications.
          </p>
          <span style="color:#d97706;font-size:14px;font-weight:600;">Testnet Faucet — Coming Soon</span>
        </div>
        <div class="card-feature">
          <span class="card-number">04</span>
          <h3 style="font-size:18px;font-weight:700;margin-bottom:0.5rem;">Community</h3>
          <p style="font-size:14px;color:#737373;line-height:1.7;margin-bottom:1rem;">
            Help other community members, create educational content, organize meetups,
            and participate in governance discussions.
          </p>
          <span style="color:#d97706;font-size:14px;font-weight:600;">Discord — Coming Soon</span>
        </div>
      </div>
    </div>
  </div>

  {/* Stats — hidden for now, dummy numbers. Set showCommunityNumbers = true to activate */}
  {showCommunityNumbers && (
  <div class="section-inset" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono-dark" style="text-align:center;margin-bottom:1rem;">Growth</p>
      <h2 class="heading-section" style="text-align:center;margin-bottom:3rem;">Community Numbers</h2>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;max-width:800px;margin:0 auto;">
        {[
          { label: 'Discord Members', num: '4200' },
          { label: 'GitHub Contributors', num: '38' },
          { label: 'Twitter Followers', num: '12800' },
          { label: 'Testnet Deployers', num: '560' },
        ].map((stat) => (
          <div style="text-align:center;padding:1.5rem 0;">
            <div class="stat-display" style="color:#ffffff;margin-bottom:0.5rem;">
              <span data-count-to={stat.num} data-count-suffix="+">0</span>
            </div>
            <div style="font-size:13px;color:rgba(255,255,255,0.4);letter-spacing:0.02em;">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
  )}

  <!-- Newsletter -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:560px;text-align:center;">
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Stay Updated</h2>
      <p class="prose-editorial" style="margin-left:auto;margin-right:auto;margin-bottom:2rem;">
        Protocol updates, development milestones, and ecosystem announcements.
        No spam, no marketing. Technical updates only.
      </p>
      <form style="display:flex;flex-direction:column;gap:0.75rem;max-width:400px;margin:0 auto;" onsubmit="event.preventDefault();">
        <input
          type="email"
          placeholder="your@email.com"
          style="padding:0.75rem 1.25rem;border-radius:8px;border:1px solid #e5e5e5;font-size:14px;outline:none;"
        />
        <button type="submit" class="btn-primary" disabled>
          Subscribe
        </button>
      </form>
      <p style="font-size:12px;color:#a3a3a3;margin-top:1rem;">
        Newsletter subscription is not yet active. Follow on Twitter/X for updates in the meantime.
      </p>
    </div>
  </div>

  <script>
    import '../scripts/reveal.ts';
    import '../scripts/counter.ts';
  </script>
</BaseLayout>
