---
/**
 * landing3.astro — v7 Complete Redesign
 * Magazine-style editorial layout. Clear narrative flow in 4 acts.
 * Act 1: What is this? → Act 2: Show me more → Act 3: Can I trust it? → Act 4: How do I start?
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/global/JsonLd.astro';
import AsSeenIn from '@/components/home/AsSeenIn.astro';
import { FAQ_ITEMS } from '@/data/faq';
import { HEADLINE_STATS } from '@/data/performance';

/* S3 capability rows data */
const capRows = [
  {
    title: 'Dual Wallet Architecture',
    desc: 'The Instant Wallet handles real-time DeFi execution with sub-200ms soft finality. The Secure Wallet provides a 24-hour reversal window for high-value transfers, with email revert and full audit trail.',
    images: [],
    inlineDualWallet: true,
    href: '/protocol/dual-wallet',
    linkText: 'Explore Dual Wallet',
    side: 'right' as const,
  },
  {
    title: 'On-Ramp / Off-Ramp',
    desc: 'Move between fiat and digital assets seamlessly through integrated payment partners. Support for card, bank transfer, and wire — enabling frictionless deposits and withdrawals.',
    images: [],
    inlineOnramp: true,
    href: '/users',
    linkText: 'Learn more',
    side: 'left' as const,
  },
  {
    title: 'Native Data Oracle',
    desc: 'Push-based oracle with multi-source aggregation at precompile addresses. No external dependencies, minimal gas overhead — price feeds built directly into the protocol.',
    images: [],
    inlineOracle: true,
    href: '/protocol/architecture',
    linkText: 'View architecture',
    side: 'right' as const,
  },
  {
    title: 'Real World Assets',
    desc: 'The Secure Wallet\'s 24-hour escrow and reversal window make Xhavic natively suited for tokenized real estate, commodities, and digital securities with institutional-grade compliance.',
    images: [],
    inlineRwa: true,
    href: '/enterprises',
    linkText: 'Explore RWA',
    side: 'left' as const,
  },
];
---

<BaseLayout
  title="Xhavic — Ethereum Layer-2 Execution Network"
  description="Ethereum L2 with protocol-level risk routing. Dual Wallet System, 2,000+ TPS, $0.04 avg fee. Full EVM compatibility. Ethereum-settled security."
>
  <!-- ═══════════════════════════════ ACT 1 ═══════════════════════════════ -->
  <!-- S1: HERO (inline — Xhavic-specific copy) -->
  <section id="home" class="token-hero" data-reveal>
    <div class="token-hero__container">
      <div class="left">
        <h1 class="token-hero__title">Build and Scale DApps With Ease</h1>
        <p class="token-hero__subtitle">
          Fast, secure, low-cost execution on an Ethereum-secured Layer-2. Built for AI agent integrations, next-gen dApps, timestamped payments, and scalable RWA ecosystems.
        </p>
        <a class="howit__btn l3-heroBtn" href="/protocol">Get started <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
      <div class="token-hero__media right">
        <video
          class="token-hero__video"
          id="tokenHeroVideo"
          muted
          autoplay
          loop
          playsinline
          preload="auto"
        >
          <source src="/videos/video3.mp4" type="video/mp4" />
        </video>
        <div class="token-hero__fade" aria-hidden="true"></div>
      </div>
    </div>
  </section>
  <!-- S2: AS SEEN IN -->
  <AsSeenIn />

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- S3: WHAT XHAVIC DOES — 6 editorial magazine rows            -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="l3-cap">
    <div class="l3-cap__container">
      <div class="l3-cap__header" data-reveal>
        <h2 class="l3-cap__heading">Key Benefits</h2>
        <p class="l3-cap__sub">An Ethereum Layer-2 that makes transactions 70× cheaper, 130× faster — and reversible. Four protocol-level capabilities that set Xhavic apart.</p>
      </div>

      <div class="l3-cap__rows">
        {capRows.map((row, i) => (
          <>
            {i > 0 && <hr class="l3-cap__divider" />}
            <div class={`l3-capRow ${row.side === 'left' ? 'l3-capRow--imgLeft' : ''}`} data-reveal>
              <div class="l3-capRow__text">
                <h3 class="l3-capRow__title">{row.title}</h3>
                <p class="l3-capRow__desc">{row.desc}</p>
                <a class="l3-capRow__link" href={row.href}>{row.linkText} &rarr;</a>
              </div>
              <div class="l3-capRow__visual" data-reveal-direction={row.side === 'left' ? 'left' : 'right'}>
                {row.inlineDualWallet ? (
                  <div class="l3-dualwallet">
                    <div class="l3-dualwallet__card">
                      <div class="l3-dualwallet__glow l3-dualwallet__glow--blue" aria-hidden="true"></div>
                      <div class="l3-dualwallet__icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#2262ff" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                      </div>
                      <div class="l3-dualwallet__label">Instant Wallet</div>
                      <div class="l3-dualwallet__meta">
                        <span class="l3-dualwallet__badge l3-dualwallet__badge--blue">&lt;200ms</span>
                        <span class="l3-dualwallet__subtext">Soft finality</span>
                      </div>
                      <div class="l3-dualwallet__bar"><div class="l3-dualwallet__barFill l3-dualwallet__barFill--blue"></div></div>
                    </div>
                    <div class="l3-dualwallet__card">
                      <div class="l3-dualwallet__glow l3-dualwallet__glow--gold" aria-hidden="true"></div>
                      <div class="l3-dualwallet__icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c4a35a" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      </div>
                      <div class="l3-dualwallet__label">Secure Wallet</div>
                      <div class="l3-dualwallet__meta">
                        <span class="l3-dualwallet__badge l3-dualwallet__badge--gold">24h</span>
                        <span class="l3-dualwallet__subtext">Reversal window</span>
                      </div>
                      <div class="l3-dualwallet__bar"><div class="l3-dualwallet__barFill l3-dualwallet__barFill--gold"></div></div>
                    </div>
                  </div>
                ) : row.inlineOnramp ? (
                  <div class="l3-onramp">
                    <div class="l3-onramp__card">
                      <div class="l3-onramp__row">
                        <div class="l3-onramp__label">From</div>
                        <div class="l3-onramp__asset">
                          <div class="l3-onramp__icon l3-onramp__icon--fiat">$</div>
                          <span class="l3-onramp__name">USD</span>
                        </div>
                        <div class="l3-onramp__amount">1,000.00</div>
                      </div>
                      <div class="l3-onramp__arrow">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M12 19l-4-4m4 4l4-4" stroke="#2262ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </div>
                      <div class="l3-onramp__row">
                        <div class="l3-onramp__label">To</div>
                        <div class="l3-onramp__asset">
                          <div class="l3-onramp__icon l3-onramp__icon--xhav">
                            <svg width="12" height="14" viewBox="0 0 723.61 887.08" fill="#fff"><polygon points="201.43 0 0 0 104.78 493.89 252.75 258.16 201.43 0"/><polygon points="723.61 0 487.53 0 272.15 355.73 123.21 580.75 263.35 580.75 66.4 887.08 688.97 306.33 472.31 306.33 723.61 0"/></svg>
                          </div>
                          <span class="l3-onramp__name">XHAV</span>
                        </div>
                        <div class="l3-onramp__amount">24,390</div>
                      </div>
                      <div class="l3-onramp__methods">
                        <div class="l3-onramp__method">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                          <span>Card</span>
                        </div>
                        <div class="l3-onramp__method">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12V7H5a2 2 0 010-4h14v4"/><path d="M3 5v14a2 2 0 002 2h16v-5"/><path d="M18 12a2 2 0 000 4h4v-4h-4z"/></svg>
                          <span>Bank</span>
                        </div>
                        <div class="l3-onramp__method">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 014 10 15 15 0 01-4 10 15 15 0 01-4-10 15 15 0 014-10z"/></svg>
                          <span>Wire</span>
                        </div>
                      </div>
                    </div>
                  </div>
                ) : row.inlineOracle ? (
                  <!-- Oracle pipeline flow graphic -->
                  <div class="l3-oracle-anim">
                    <div class="l3-oracle-anim__grid"></div>

                    <!-- Pipeline stages -->
                    <div class="l3-oracle-pipe">
                      <!-- Stage 1: Chainlink Data Feeds -->
                      <div class="l3-oracle-pipe__stage l3-oracle-pipe__stage--1">
                        <div class="l3-oracle-pipe__icon l3-oracle-pipe__icon--blue">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2262ff" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                        </div>
                        <div class="l3-oracle-pipe__text">
                          <span class="l3-oracle-pipe__label">Chainlink Data Feeds</span>
                          <span class="l3-oracle-pipe__sub">External price oracles</span>
                        </div>
                      </div>

                      <!-- Arrow connector 1 -->
                      <div class="l3-oracle-pipe__arrow l3-oracle-pipe__arrow--1">
                        <svg width="16" height="28" viewBox="0 0 16 28" fill="none"><line x1="8" y1="0" x2="8" y2="20" stroke="rgba(34,98,255,0.4)" stroke-width="1.5" stroke-dasharray="4 3"/><path d="M3 17l5 8 5-8" fill="none" stroke="rgba(34,98,255,0.5)" stroke-width="1.5"/></svg>
                      </div>

                      <!-- Stage 2: L1 Oracle Contract -->
                      <div class="l3-oracle-pipe__stage l3-oracle-pipe__stage--2">
                        <div class="l3-oracle-pipe__icon l3-oracle-pipe__icon--purple">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12h8M12 8v8"/></svg>
                        </div>
                        <div class="l3-oracle-pipe__text">
                          <span class="l3-oracle-pipe__label">L1 Oracle Contract</span>
                          <span class="l3-oracle-pipe__sub">Sepolia (Ethereum L1)</span>
                        </div>
                      </div>

                      <!-- Arrow connector 2 -->
                      <div class="l3-oracle-pipe__arrow l3-oracle-pipe__arrow--2">
                        <svg width="16" height="28" viewBox="0 0 16 28" fill="none"><line x1="8" y1="0" x2="8" y2="20" stroke="rgba(196,163,90,0.4)" stroke-width="1.5" stroke-dasharray="4 3"/><path d="M3 17l5 8 5-8" fill="none" stroke="rgba(196,163,90,0.5)" stroke-width="1.5"/></svg>
                      </div>

                      <!-- Stage 3: Relayer Script -->
                      <div class="l3-oracle-pipe__stage l3-oracle-pipe__stage--3">
                        <div class="l3-oracle-pipe__icon l3-oracle-pipe__icon--gold">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c4a35a" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                        </div>
                        <div class="l3-oracle-pipe__text">
                          <span class="l3-oracle-pipe__label">Relayer Script</span>
                          <span class="l3-oracle-pipe__sub">Cross-chain data bridge</span>
                        </div>
                      </div>

                      <!-- Arrow connector 3 -->
                      <div class="l3-oracle-pipe__arrow l3-oracle-pipe__arrow--3">
                        <svg width="16" height="28" viewBox="0 0 16 28" fill="none"><line x1="8" y1="0" x2="8" y2="20" stroke="rgba(34,197,94,0.4)" stroke-width="1.5" stroke-dasharray="4 3"/><path d="M3 17l5 8 5-8" fill="none" stroke="rgba(34,197,94,0.5)" stroke-width="1.5"/></svg>
                      </div>

                      <!-- Stage 4: L2 Oracle Contract -->
                      <div class="l3-oracle-pipe__stage l3-oracle-pipe__stage--4">
                        <div class="l3-oracle-pipe__icon l3-oracle-pipe__icon--green">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path d="M9 12l2 2 4-4"/></svg>
                        </div>
                        <div class="l3-oracle-pipe__text">
                          <span class="l3-oracle-pipe__label">L2 Oracle Contract</span>
                          <span class="l3-oracle-pipe__sub">Xhavic Blockchain</span>
                        </div>
                      </div>

                      <!-- Arrow connector 4 -->
                      <div class="l3-oracle-pipe__arrow l3-oracle-pipe__arrow--4">
                        <svg width="16" height="28" viewBox="0 0 16 28" fill="none"><line x1="8" y1="0" x2="8" y2="20" stroke="rgba(34,98,255,0.4)" stroke-width="1.5" stroke-dasharray="4 3"/><path d="M3 17l5 8 5-8" fill="none" stroke="rgba(34,98,255,0.5)" stroke-width="1.5"/></svg>
                      </div>

                      <!-- Stage 5: DeFi / Trading Applications -->
                      <div class="l3-oracle-pipe__stage l3-oracle-pipe__stage--5">
                        <div class="l3-oracle-pipe__icon l3-oracle-pipe__icon--cyan">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 4-8"/></svg>
                        </div>
                        <div class="l3-oracle-pipe__text">
                          <span class="l3-oracle-pipe__label">DeFi / Trading Apps</span>
                          <span class="l3-oracle-pipe__sub">End-user applications</span>
                        </div>
                      </div>
                    </div>

                    <!-- Animated data pulse traveling down -->
                    <div class="l3-oracle-pipe__pulse"></div>

                    <!-- Glows -->
                    <div class="l3-oracle-anim__glow l3-oracle-anim__glow--blue"></div>
                    <div class="l3-oracle-anim__glow l3-oracle-anim__glow--gold"></div>
                  </div>
                ) : row.inlineRwa ? (
                  <!-- RWA animated graphic -->
                  <div class="l3-rwa-anim">
                    <div class="l3-rwa-anim__grid"></div>
                    <!-- Token cards -->
                    <div class="l3-rwa-anim__token l3-rwa-anim__token--1">
                      <div class="l3-rwa-anim__tokenIcon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c4a35a" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                      </div>
                      <span class="l3-rwa-anim__tokenName">Real Estate</span>
                      <span class="l3-rwa-anim__tokenVal">$2.4M</span>
                    </div>
                    <div class="l3-rwa-anim__token l3-rwa-anim__token--2">
                      <div class="l3-rwa-anim__tokenIcon l3-rwa-anim__tokenIcon--blue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2262ff" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
                      </div>
                      <span class="l3-rwa-anim__tokenName">Commodities</span>
                      <span class="l3-rwa-anim__tokenVal">$890K</span>
                    </div>
                    <div class="l3-rwa-anim__token l3-rwa-anim__token--3">
                      <div class="l3-rwa-anim__tokenIcon l3-rwa-anim__tokenIcon--green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                      </div>
                      <span class="l3-rwa-anim__tokenName">Securities</span>
                      <span class="l3-rwa-anim__tokenVal">$5.1M</span>
                    </div>
                    <!-- Escrow badge -->
                    <div class="l3-rwa-anim__escrow">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      <span>24h Escrow Protected</span>
                    </div>
                    <!-- Glows -->
                    <div class="l3-rwa-anim__glow l3-rwa-anim__glow--gold"></div>
                    <div class="l3-rwa-anim__glow l3-rwa-anim__glow--blue"></div>
                  </div>
                ) : row.images.length === 2 ? (
                  <div class="l3-capRow__dualImg">
                    <img src={row.images[0]} alt="" loading="lazy" />
                    <img src={row.images[1]} alt="" loading="lazy" />
                  </div>
                ) : row.images.length === 1 ? (
                  <div class="l3-capRow__imgFull">
                    <img class="l3-capRow__imgBg" src={row.images[0]} alt="" loading="lazy" />
                    <div class="l3-capRow__overlay"></div>
                  </div>
                ) : null}
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- S4: AI ADVANTAGE (moved up)                                 -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="l3-ai">
    <div class="l3-ai__container">
      <div class="l3-ai__left" data-reveal-direction="left" data-reveal>
        <div class="l3-ai__glow" aria-hidden="true"></div>
        <img class="l3-ai__robot" src="/images/robot/1.png" alt="AI Agent" width="600" height="803" loading="lazy" />
      </div>
      <div class="l3-ai__right" data-reveal-direction="right" data-reveal>
        <h2 class="l3-ai__heading">Unlocking the AI advantage <br/>with XHAVIC</h2>
        <ul class="l3-ai__list">
          <li class="l3-ai__item">
            <span class="l3-ai__check" aria-hidden="true">&#10003;</span>
            <div>
              <h4>Seamless AI-Agent Integration</h4>
              <p>Connect any AI agent and run workflows on Xhavic without friction.</p>
            </div>
          </li>
          <li class="l3-ai__item">
            <span class="l3-ai__check" aria-hidden="true">&#10003;</span>
            <div>
              <h4>Automated On-Chain Actions</h4>
              <p>Agents can monitor conditions and trigger trades, payments, rebalancing, and verification — fast on L2, secured by Ethereum.</p>
            </div>
          </li>
          <li class="l3-ai__item">
            <span class="l3-ai__check" aria-hidden="true">&#10003;</span>
            <div>
              <h4>Built for AI-Native dApps</h4>
              <p>EVM-compatible, scalable infrastructure designed for real-world AI + Web3 products.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- COMMUNITY ORBIT — scroll-driven avatar animation              -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="l3-community">
    <div class="l3-community__header" data-reveal>
      <h2 class="l3-community__heading">Community & Contribution</h2>
      <p class="l3-community__sub">Xhavic welcomes open collaboration from developers, researchers, educators, and users. The ecosystem grows through shared knowledge, transparent standards, and open-source participation.</p>
      <a class="l3-community__btn" href="/community">Join Now</a>
    </div>

    <div class="l3-community__orbit" id="communityOrbitWrap">
      <div class="l3-community__stickyPanel">
        <div class="l3-community__scene" id="communityScene">
          <!-- Rings -->
          <div class="l3-community__rings"></div>
          <!-- Center logo with bg.png -->
          <div class="l3-community__center l3-community__bg">
            <div class="l3-community__centerInner">
              <img class="l3-community__logo" src="/images/xhavic-icon-v2.png" alt="Xhavic" />
            </div>
          </div>
          <!-- Avatar anchor -->
          <div class="l3-community__anchor">
            <div class="l3-community__avatar l3-av-1" data-layer="1">
              <img src="https://images.unsplash.com/photo-1544723795-3fb6469f5b39?w=600&q=80&auto=format&fit=crop" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-2" data-layer="2">
              <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=600&q=80&auto=format&fit=crop" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-3" data-layer="3">
              <img src="https://framerusercontent.com/images/fGMII2DZxHfMG5shcSEK1AnhYvw.png?scale-down-to=1024" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-4" data-layer="4">
              <img src="https://framerusercontent.com/images/3tKsVb3psNppIRvC1PoQT4FgoQ.jpg" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-5" data-layer="5">
              <img src="https://framerusercontent.com/images/48Cqhfwpt7z7CH4A5eVCCMQGbEg.jpg" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-6" data-layer="6">
              <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=600&q=80&auto=format&fit=crop" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-7" data-layer="7">
              <img src="https://framerusercontent.com/images/XOzKSXQTs1DdcEoA8hOXV38WL6M.png?scale-down-to=512" alt="Community member" loading="lazy" />
            </div>
            <div class="l3-community__avatar l3-av-8" data-layer="8">
              <img src="https://framerusercontent.com/images/MYlrVK7d5fXdfloNrfa5uiX75UI.jpg" alt="Community member" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- S5: USE CASES — premium bento grid                          -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="l3-uc">
    <div class="l3-uc__container">
      <div class="l3-uc__header" data-reveal>
        <h2 class="l3-uc__heading">Built for every<br/>use case</h2>
