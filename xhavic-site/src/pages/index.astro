<script>
(function () {
  /* AI section — trigger robot slide-in when visible */
  function initAiReveal() {
    var ai = document.querySelector('.l3-ai');
    if (!ai) return;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          ai.classList.add('is-in');
        } else {
          ai.classList.remove('is-in');
        }
      });
    }, { threshold: 0.15 });
    observer.observe(ai);
  }
  initAiReveal();
  document.addEventListener('astro:after-swap', initAiReveal);
})();
</script>
<script>
(function () {
  /* Hero video init — force visibility (same as Hero.astro) */
  function initHeroVideo() {
    var video = document.getElementById('tokenHeroVideo');
    if (!video) return;
    video.style.display = 'block';
    video.style.opacity = '1';
    video.style.background = '#000';
    video.style.position = 'relative';
    video.muted = true;
    video.play().catch(function () {});
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
  document.addEventListener('astro:after-swap', initHeroVideo);
})();
</script>
