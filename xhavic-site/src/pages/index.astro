  .l3-uc__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(15,23,42,0.10), 0 8px 16px rgba(15,23,42,0.04);
    border-color: rgba(34,98,255,0.2);
  }

  /* Gradient glow on hover — per-card accent */
  .l3-uc__cardGlow {
    position: absolute; inset: 0; opacity: 0; transition: opacity 0.4s ease; pointer-events: none; z-index: 0;
  }
  .l3-uc__card:hover .l3-uc__cardGlow { opacity: 1; }
  .l3-uc__card--defi .l3-uc__cardGlow { background: linear-gradient(135deg, rgba(34,98,255,0.04) 0%, transparent 60%); }
  .l3-uc__card--rwa .l3-uc__cardGlow { background: linear-gradient(135deg, rgba(196,163,90,0.05) 0%, transparent 60%); }
  .l3-uc__card--ai .l3-uc__cardGlow { background: linear-gradient(135deg, rgba(34,197,94,0.04) 0%, transparent 60%); }
  .l3-uc__card--inst .l3-uc__cardGlow { background: linear-gradient(135deg, rgba(139,92,246,0.04) 0%, transparent 60%); }
  .l3-uc__card--game .l3-uc__cardGlow { background: linear-gradient(135deg, rgba(236,72,153,0.04) 0%, transparent 60%); }

  /* Inner */
  .l3-uc__cardInner { position: relative; z-index: 1; padding: 28px 28px 24px; display: flex; flex-direction: column; gap: 14px; height: 100%; }

  /* Wide card — spans 2 cols, horizontal layout */
  .l3-uc__card--wide { grid-column: span 2; }
  .l3-uc__card--wide .l3-uc__cardInner { flex-direction: row; flex-wrap: wrap; align-items: flex-start; gap: 20px; }
  .l3-uc__card--wide .l3-uc__cardContent { flex: 1; min-width: 260px; }

  /* Icon */
  .l3-uc__cardIcon { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; flex-shrink: 0; }
  .l3-uc__cardIcon--blue { background: rgba(34,98,255,0.08); color: #2262ff; border: 1px solid rgba(34,98,255,0.12); }
  .l3-uc__cardIcon--gold { background: rgba(196,163,90,0.08); color: #c4a35a; border: 1px solid rgba(196,163,90,0.12); }
  .l3-uc__cardIcon--green { background: rgba(34,197,94,0.08); color: #22c55e; border: 1px solid rgba(34,197,94,0.12); }
  .l3-uc__cardIcon--purple { background: rgba(139,92,246,0.08); color: #8b5cf6; border: 1px solid rgba(139,92,246,0.12); }
  .l3-uc__cardIcon--pink { background: rgba(236,72,153,0.08); color: #ec4899; border: 1px solid rgba(236,72,153,0.12); }

  /* Title + Desc */
  .l3-uc__cardTitle { font-size: 20px; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.25; }
  .l3-uc__cardDesc { font-size: 14.5px; color: #64748b; line-height: 1.6; margin: 0; }

  /* Staggered reveal */
  .l3-uc__grid .l3-uc__card { opacity: 0; transform: translateY(28px) scale(0.97); }
  .l3-uc__grid.is-visible .l3-uc__card { transition: opacity 0.6s cubic-bezier(0.16,1,0.3,1), transform 0.6s cubic-bezier(0.16,1,0.3,1); opacity: 1; transform: translateY(0) scale(1); }
  .l3-uc__grid.is-visible .l3-uc__card:nth-child(1) { transition-delay: 0.05s; }
  .l3-uc__grid.is-visible .l3-uc__card:nth-child(2) { transition-delay: 0.12s; }
  .l3-uc__grid.is-visible .l3-uc__card:nth-child(3) { transition-delay: 0.19s; }
  .l3-uc__grid.is-visible .l3-uc__card:nth-child(4) { transition-delay: 0.26s; }
  .l3-uc__grid.is-visible .l3-uc__card:nth-child(5) { transition-delay: 0.33s; }

  /* Responsive */
  @media (max-width: 768px) {
    .l3-uc { padding: 3.5rem 0 4rem; }
    .l3-uc__header { margin-bottom: 2.5rem; }
    .l3-uc__grid { grid-template-columns: 1fr; }
    .l3-uc__card--wide { grid-column: span 1; }
    .l3-uc__card--wide .l3-uc__cardInner { flex-direction: column; }
    .l3-uc__cardInner { padding: 22px; }
    .l3-uc__cardIcon { width: 44px; height: 44px; border-radius: 12px; }
    .l3-uc__cardArrow { top: 18px; right: 18px; width: 32px; height: 32px; }
  }

  /* ─── HOW XHAVIC WORKS ──────────────────────────────────────── */
  .l3-how { background: #fff; padding: 5rem 0; }
  .l3-how__container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .l3-how__header { margin-bottom: 3rem; }
  .l3-how__heading { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #171717; letter-spacing: -0.03em; margin: 0 0 1rem; }
  .l3-how__sub { font-size: 15px; color: #737373; line-height: 1.6; margin: 0; max-width: 600px; }
  .l3-how__body { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }

  /* Accordion steps */
  .l3-how__steps { display: flex; flex-direction: column; gap: 0; }
  .l3-how__step { border-bottom: 1px solid #e5e5e5; }
  .l3-how__step:first-child { border-top: 1px solid #e5e5e5; }
  .l3-how__stepHead { display: flex; align-items: center; gap: 16px; padding: 1.25rem 0; cursor: pointer; list-style: none; }
  .l3-how__stepHead::-webkit-details-marker { display: none; }
  .l3-how__stepNum { font-family: var(--font-mono, monospace); font-size: 13px; font-weight: 700; color: #2262ff; min-width: 28px; }
  .l3-how__stepTitle { font-size: 1.1rem; font-weight: 700; color: #171717; flex: 1; }
  .l3-how__stepToggle { width: 24px; height: 24px; border-radius: 50%; background: #f5f5f5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s, transform 0.2s; position: relative; }
  .l3-how__stepToggle::before { content: '+'; font-size: 16px; font-weight: 600; color: #737373; line-height: 1; }
  .l3-how__step[open] .l3-how__stepToggle { background: #2262ff; }
  .l3-how__step[open] .l3-how__stepToggle::before { content: '−'; color: #fff; }
  .l3-how__stepBody { font-size: 14px; color: #737373; line-height: 1.7; margin: 0; padding: 0 0 1.25rem 44px; animation: how-body-in 0.3s ease; }
  @keyframes how-body-in { from { opacity: 0; max-height: 0; padding-bottom: 0; } to { opacity: 1; max-height: 200px; padding-bottom: 1.25rem; } }

  /* How It Works — SVG preview panels (stacked, no layout shift) */
  .l3-how__visual { position: sticky; top: 100px; }
  .l3-how__panelWrap { position: relative; width: 100%; aspect-ratio: 480 / 400; }
  .l3-how__panel { position: absolute; inset: 0; border-radius: 20px; overflow: hidden; background: #f8fafc; border: 1px solid #e5e7eb; padding: 1rem; opacity: 0; pointer-events: none; transition: opacity 0.35s ease, transform 0.35s ease; transform: translateY(8px) scale(0.98); display: flex; align-items: center; justify-content: center; }
  .l3-how__panel.is-active { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
  .l3-how__svg { width: 100%; height: auto; display: block; }
  .l3-how__arrow { animation: how-dash-flow 2s linear infinite; }
  @keyframes how-dash-flow { to { stroke-dashoffset: -40; } }

  @media (max-width: 768px) {
    .l3-how__body { grid-template-columns: 1fr; }
    .l3-how__visual { position: static; }
  }

  /* ─── S6: NETWORK PERFORMANCE ────────────────────────────────── */
  .l3-perf { background: #000; color: #fff; padding: 5rem 0; }
  .l3-perf__container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .l3-perf__header { text-align: center; margin-bottom: 3.5rem; }
  .l3-perf__heading { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 0.75rem; color: #fff; }
  .l3-perf__subtitle { font-size: 15px; color: rgba(255,255,255,0.5); margin: 0; }
  .l3-perf__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; margin-bottom: 3rem; }
  .l3-perf__card { background: #0a0a0a; padding: 2.5rem 2rem; text-align: center; transition: background 0.2s; }
  .l3-perf__card:hover { background: #111; }
  .l3-perf__number { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; color: #fff; line-height: 1; margin-bottom: 0.75rem; font-variant-numeric: tabular-nums; }
  .l3-perf__label { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.7); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .l3-perf__detail { font-size: 12px; color: rgba(255,255,255,0.35); line-height: 1.4; }
  .l3-perf__footer { display: flex; justify-content: center; gap: 2.5rem; flex-wrap: wrap; }
  .l3-perf__footerItem { display: flex; align-items: center; gap: 0.5rem; font-size: 13px; color: rgba(255,255,255,0.4); font-weight: 500; }
  .l3-perf__footerItem svg { color: #2262ff; flex-shrink: 0; }
  @media (max-width: 768px) { .l3-perf__grid { grid-template-columns: repeat(2, 1fr); } .l3-perf__card { padding: 2rem 1.25rem; } .l3-perf__footer { gap: 1.5rem; } }
  @media (max-width: 480px) { .l3-perf__grid { grid-template-columns: 1fr; } .l3-perf__footer { flex-direction: column; align-items: center; gap: 1rem; } }

  /* ─── S8: AI (dark — matches original DevQuickStart) ─────────── */
  .l3-ai { padding: 5rem 0; background: #030b1d; overflow: hidden; border-top: 1px solid rgba(255,255,255,.06); }
  .l3-ai__container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: center; }
  .l3-ai__left { position: relative; display: flex; justify-content: center; min-height: 320px; }
  .l3-ai__glow { position: absolute; inset: -80px; background: radial-gradient(circle at 40% 50%, rgba(59,109,255,.20), rgba(124,77,255,.10), rgba(0,0,0,0) 65%); pointer-events: none; z-index: 1; }
  .l3-ai__robot { max-width: 380px; width: 100%; filter: drop-shadow(0 26px 60px rgba(0,0,0,.35)); position: relative; z-index: 2; opacity: 0; transform: translateX(-90px) scale(.98); }
  .l3-ai.is-in .l3-ai__robot { animation: robotSlideIn 3500ms cubic-bezier(.22,1,.36,1) both; }
  .l3-ai__heading { font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; color: #fff; letter-spacing: -0.02em; margin: 0 0 2rem; }
  .l3-ai__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .l3-ai__item { display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: start; opacity: 0; transform: translateY(16px); }
  .l3-ai__check { width: 20px; height: 20px; border-radius: 999px; background: rgba(59,109,255,0.18); border: 1px solid rgba(59,109,255,0.35); color: #cfe1ff; font-size: 12px; display: grid; place-items: center; margin-top: 2px; flex-shrink: 0; }
  .l3-ai__item h4 { font-size: 16px; font-weight: 800; color: #fff; margin: 0 0 4px; }
  .l3-ai__item p { font-size: 14.5px; color: rgba(255,255,255,0.70); line-height: 1.6; margin: 0; max-width: 520px; }
  .l3-ai.is-in .l3-ai__item { animation: ai-item-in 0.6s ease forwards; }
  .l3-ai.is-in .l3-ai__item:nth-child(1) { animation-delay: 0.3s; }
  .l3-ai.is-in .l3-ai__item:nth-child(2) { animation-delay: 0.6s; }
  .l3-ai.is-in .l3-ai__item:nth-child(3) { animation-delay: 0.9s; }
  @keyframes ai-item-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 768px) { .l3-ai__container { grid-template-columns: 1fr; } .l3-ai__robot { max-width: 260px; } .l3-ai__left { min-height: 240px; } }

  /* ─── S9: GET STARTED (tabbed interface) ──────────────────── */
  .l3-gs { background: #fafafa; padding: 5rem 0; }
  .l3-gs__container { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; }
  .l3-gs__head { margin-bottom: 1.5rem; }
  .l3-gs__heading { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; color: #171717; letter-spacing: -0.03em; margin: 0 0 0.5rem; }
  .l3-gs__sub { font-size: 15px; color: #737373; line-height: 1.6; margin: 0; max-width: 620px; }

  .l3-gs__panel { border: 1px solid #e5e5e5; background: #fff; border-radius: 20px; padding: 1.25rem; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 1.25rem; }
  .l3-gs__left { padding: 10px 10px 14px; }

  .l3-gs__tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 1.25rem; }
  .l3-gsTab { border-radius: 14px; border: 1px solid #e5e5e5; background: #fff; padding: 14px; text-align: left; cursor: pointer; min-height: 80px; transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease; }
  .l3-gsTab:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(0,0,0,0.06); }
  .l3-gsTab__icon { width: 40px; height: 40px; margin-bottom: 8px; }
  .l3-gsTab__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .l3-gsTab__label { font-size: 14px; font-weight: 700; color: #525252; letter-spacing: -0.02em; }
  .l3-gsTab.is-active { border-color: rgba(34,98,255,0.55); box-shadow: 0 12px 28px rgba(34,98,255,0.08); }
  .l3-gsTab.is-active .l3-gsTab__label { color: #2262ff; }

  .l3-gs__detail { padding: 8px 4px 0; }
  .l3-gs__detailTitle { margin: 0 0 8px; font-weight: 800; letter-spacing: -0.03em; font-size: 22px; color: #171717; }
  .l3-gs__detailDesc { margin: 0 0 12px; color: #737373; font-size: 14px; line-height: 1.65; max-width: 520px; }
  .l3-gs__points { list-style: none; padding: 0; margin: 0 0 18px; }
  .l3-gs__points li { position: relative; padding-left: 18px; font-size: 13px; color: #525252; line-height: 1.55; margin-bottom: 6px; }
  .l3-gs__points li::before { content: ''; position: absolute; left: 0; top: 7px; width: 6px; height: 6px; border-radius: 50%; background: #2262ff; }
  .l3-gs__cta { display: inline-flex; align-items: center; padding: 11px 20px; border-radius: 999px; background: #2262ff; color: #fff; font-weight: 700; font-size: 14px; text-decoration: none; box-shadow: 0 12px 28px rgba(34,98,255,0.22); transition: transform 180ms ease, box-shadow 180ms ease; }
  .l3-gs__cta:hover { transform: translateY(-1px); box-shadow: 0 18px 36px rgba(34,98,255,0.28); }

  .l3-gs__preview { height: 100%; border-radius: 16px; overflow: hidden; }
  #l3GsImg { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 12px; transition: opacity 200ms ease, transform 260ms ease; }
  #l3GsImg.is-out { opacity: 0; transform: scale(0.92); transition: opacity 180ms ease, transform 180ms ease; }
  #l3GsImg.is-in { opacity: 1; transform: scale(1); transition: opacity 280ms ease, transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1); }

  @media (max-width: 768px) {
    .l3-gs__panel { grid-template-columns: 1fr; }
    .l3-gs__tabs { grid-template-columns: repeat(2, 1fr); }
  }

  /* ─── S10: DEVELOPER QUICK-CONNECT ──────────────────────────── */
  .l3-dev { background: #0a0a0a; color: #fff; padding: 5rem 0; }
  .l3-dev__container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .l3-dev__header { text-align: center; margin-bottom: 3rem; }
  .l3-dev__heading { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.03em; margin: 0; }

  .l3-dev__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; margin-bottom: 2.5rem; }
  .l3-dev__card { background: #111; padding: 2rem 1.5rem; }
  .l3-dev__cardLabel { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #737373; margin-bottom: 0.75rem; }
  .l3-dev__cardValue { display: flex; align-items: center; gap: 10px; }
  .l3-dev__cardValue code,
  .l3-dev__cardValue a { font-family: var(--font-mono, monospace); font-size: 14px; color: #2262ff; word-break: break-all; text-decoration: none; }
  .l3-dev__cardValue a:hover { text-decoration: underline; }
  .l3-dev__cardValue svg { color: #525252; flex-shrink: 0; }

  .l3-dev__copy { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: transparent; color: #737373; cursor: pointer; flex-shrink: 0; transition: border-color 0.2s, color 0.2s; }
  .l3-dev__copy:hover { border-color: #2262ff; color: #2262ff; }

  .l3-dev__links { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; }
  .l3-dev__link { font-size: 14px; font-weight: 600; color: #737373; text-decoration: none; transition: color 0.2s; }
  .l3-dev__link:hover { color: #2262ff; }

  @media (max-width: 768px) {
    .l3-dev__grid { grid-template-columns: 1fr; }
  }

  /* (S11 Ready to Build — removed, merged into S9 Get Started) */

  /* ─── S12: FAQ ──────────────────────────────────────────────────── */
  .l3-faq { padding: 4rem 0; background: #fff; position: relative; overflow: hidden; }
  .l3-faq__decor { position: absolute; right: -200px; top: 50%; transform: translateY(-50%); opacity: 0.12; max-width: 500px; pointer-events: none; }
  .l3-faq__container { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 1; }
  .l3-faq__heading { font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; color: #171717; letter-spacing: -0.02em; text-align: center; margin: 0 0 2rem; }
  .l3-faqItem { border-bottom: 1px solid #e5e5e5; }
  .l3-faqQ { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 0; font-size: 16px; font-weight: 600; color: #171717; background: none; border: none; cursor: pointer; text-align: left; gap: 1rem; }
  .l3-faqQ__icon { font-size: 20px; color: #a3a3a3; flex-shrink: 0; transition: transform 0.2s, color 0.2s; }
  .l3-faqItem.is-open .l3-faqQ__icon { transform: rotate(45deg); color: #2262ff; }
  .l3-faqA { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .l3-faqA__inner { padding: 0 0 1.25rem; font-size: 15px; color: #737373; line-height: 1.65; opacity: 0; transform: translateY(-8px); transition: opacity 0.3s 0.1s, transform 0.3s 0.1s; }
  .l3-faqItem.is-open .l3-faqA__inner { opacity: 1; transform: translateY(0); }

  /* ─── COMMUNITY ORBIT (light background — original style) ──────── */
  .l3-community {
    padding: 80px 0 0;
    background: #f1f2f3;
    /* overflow must NOT be hidden/clip — it breaks position:sticky on stickyPanel */
  }

  .l3-community__header { text-align: center; max-width: 620px; margin: 0 auto; padding: 0 1.5rem; }

  .l3-community__heading {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem); font-weight: 900;
    letter-spacing: -0.03em; color: #171717; margin: 0 0 14px; line-height: 1.1;
  }

  .l3-community__sub {
    font-size: 15px; color: #6b7280; line-height: 1.65; margin: 0 0 24px;
  }

  .l3-community__btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 12px 28px; border-radius: 999px;
    background: #2262ff; color: #fff; font-weight: 700; font-size: 14px;
    text-decoration: none; border: none;
    box-shadow: 0 4px 16px rgba(34,98,255,0.25);
    transition: box-shadow 0.3s, transform 0.2s;
  }
  .l3-community__btn:hover {
    box-shadow: 0 6px 24px rgba(34,98,255,0.4);
    transform: translateY(-1px);
  }

  /* Orbit wrapper — exact copy from original styles.css */
  .l3-community__orbit {
    height: 350vh; position: relative;
    overflow: clip;
    background: #f1f2f3;
  }

  .l3-community__stickyPanel {
    position: sticky; top: 0; height: 100vh;
    display: grid; place-items: center;
    /* 77px top-padding offsets for the fixed navbar so orbit
       centres in the visible area below the nav */
    padding: 77px 16px 0;
    box-sizing: border-box;
  }

  .l3-community__scene {
    width: 80%; height: 100%;
    position: relative; border-radius: 34px;
    background: #f1f2f3;
    margin: 0 auto;
  }

  /* Rings — hidden; bg.png already provides the ring circles */
  .l3-community__rings {
    display: none;
  }

  /* Center — exact copy from original .center */
  .l3-community__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    z-index: 2;
    padding: 16px;
  }
  /* bg.png rings — background only, no size/margin overrides that break inset:0 centering */
  .l3-community__bg {
    background-image: url(/images/bg.png);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
  }
  .l3-community__centerInner {
    transform: scale(calc(0.1 + (var(--p, 0) * 0.9)));
    opacity: calc(0.1 + (var(--p, 0) * 0.9));
    filter: blur(calc((1 - var(--p, 0)) * 3px));
    transition: transform 0.06s linear, opacity 0.06s linear, filter 0.06s linear;
    will-change: transform, opacity, filter;
  }
  .l3-community__logo { width: 150px; }

  /* Avatars anchor — exact copy from original .anchor */
  .l3-community__anchor {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%); z-index: 3;
  }

  /* Base avatar */
  .l3-community__avatar {
    --tx: 0px; --ty: 0px; --cx: 0px; --cy: 0px;
