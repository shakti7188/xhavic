<script>
(function () {
  /* FAQ accordion */
  function initFaq() {
    var list = document.getElementById('l3FaqList');
    if (!list) return;
    var items = list.querySelectorAll('.l3-faqItem');
    items.forEach(function (item) {
      var btn = item.querySelector('.l3-faqQ');
      var body = item.querySelector('.l3-faqA');
      if (!btn || !body) return;
      btn.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');
        items.forEach(function (o) { o.classList.remove('is-open'); var ob = o.querySelector('.l3-faqA'); if (ob) ob.style.maxHeight = '0px'; var obtn = o.querySelector('.l3-faqQ'); if (obtn) obtn.setAttribute('aria-expanded', 'false'); });
        if (!isOpen) { item.classList.add('is-open'); body.style.maxHeight = body.scrollHeight + 'px'; btn.setAttribute('aria-expanded', 'true'); }
      });
    });
  }
  initFaq();
  document.addEventListener('astro:after-swap', initFaq);
})();
</script>
<script>
(function () {
  /* How Xhavic Works — exclusive accordion + panel swap */
  function initHow() {
    var wrap = document.getElementById('l3HowSteps');
    if (!wrap) return;
    var steps = wrap.querySelectorAll('.l3-how__step');
    var panels = document.querySelectorAll('.l3-how__panel[data-how-panel]');
    if (!panels.length) return;

    function showPanel(idx) {
      panels.forEach(function (p) { p.classList.remove('is-active'); });
      var target = document.querySelector('.l3-how__panel[data-how-panel="' + idx + '"]');
      if (target) target.classList.add('is-active');
    }

    steps.forEach(function (det) {
      det.addEventListener('toggle', function () {
        if (!det.open) return;
        steps.forEach(function (other) {
          if (other !== det && other.open) other.open = false;
        });
        var idx = det.getAttribute('data-panel');
        if (idx !== null) showPanel(parseInt(idx, 10));
      });
    });

    if (!wrap.querySelector('.l3-how__step[open]')) {
      steps[0].open = true;
    }
  }
  initHow();
  document.addEventListener('astro:after-swap', initHow);
})();
</script>
<script>
(function () {
  /* Get Started — tab switching with image swap */
  var gsTabData = [
    {
      title: 'Users',
      desc: 'Discover and use decentralized applications on Xhavic \u2014 swap tokens, mint NFTs, bridge assets, and interact with DeFi protocols, all with near-instant confirmation and fees under $0.04.',
      points: [
        'Connect any EVM wallet \u2014 MetaMask, WalletConnect, and more',
        'Sub-200ms soft finality with 24-hour reversal protection',
        'Browse the ecosystem of live dApps and start transacting',
      ],
      ctaText: 'Explore apps \u2192',
      ctaHref: '/ecosystem',
      image: '/images/get_started/3.jpg',
    },
    {
      title: 'Developers',
      desc: 'Deploy Solidity and Vyper smart contracts without code changes. Xhavic Labs provides technical guidance, security reviews, dev tooling, and go-to-market support to help you ship production-ready products.',
      points: [
        'Full EVM compatibility \u2014 Hardhat, Foundry, Remix, and Ethers.js',
        'Xhavic Labs incubator: architecture reviews, audits, and SDKs',
        'Apply to Xhavic Labs for hands-on launch support',
      ],
      ctaText: 'Build with Xhavic \u2192',
      ctaHref: '/developers',
      image: '/images/get_started/2.jpg',
    },
    {
      title: 'Enterprises',
      desc: 'Integrate blockchain infrastructure into your business with Ethereum-grade security. Tokenize real-world assets, automate compliance workflows, and connect fiat rails to Web3 with institutional-grade tooling.',
      points: [
        'RWA-compliant infrastructure with full audit trails',
        'On-ramp and off-ramp integration for seamless fiat \u2194 crypto',
        'Dedicated integration support and SLA-backed infrastructure',
      ],
      ctaText: 'Contact team \u2192',
      ctaHref: '/enterprises',
      image: '/images/get_started/1.jpg',
    },
  ];

  function initGetStarted() {
    var container = document.getElementById('l3GsTabs');
    var titleEl = document.getElementById('l3GsTitle');
    var descEl = document.getElementById('l3GsDesc');
    var pointsEl = document.getElementById('l3GsPoints');
    var ctaEl = document.getElementById('l3GsCta');
    var imgEl = document.getElementById('l3GsImg');
    if (!container || !titleEl || !descEl || !pointsEl || !ctaEl || !imgEl) return;

    var cards = container.querySelectorAll('.l3-gsTab');
    var current = 0;

    function activate(idx) {
      if (idx === current) return;
      var data = gsTabData[idx];
      if (!data) return;

      // Update active tab
      cards.forEach(function (c) { c.classList.remove('is-active'); });
      cards[idx].classList.add('is-active');

      // Animate image out
      imgEl.classList.remove('is-in');
      imgEl.classList.add('is-out');

      setTimeout(function () {
        titleEl.textContent = data.title;
        descEl.textContent = data.desc;
        // Swap bullet points
        pointsEl.innerHTML = '';
        if (data.points) {
          data.points.forEach(function (pt) {
            var li = document.createElement('li');
            li.textContent = pt;
            pointsEl.appendChild(li);
          });
        }
        ctaEl.textContent = data.ctaText;
        ctaEl.href = data.ctaHref;
        imgEl.src = data.image;

        imgEl.classList.remove('is-out');
        imgEl.classList.add('is-in');

        setTimeout(function () { imgEl.classList.remove('is-in'); }, 300);
      }, 200);

      current = idx;
    }

    cards.forEach(function (card, i) {
      card.addEventListener('click', function () { activate(i); });
    });

    imgEl.classList.add('is-in');
  }

  initGetStarted();
  document.addEventListener('astro:after-swap', initGetStarted);
})();
</script>
<script>
(function () {
  /* Copy buttons for Dev Quick-Connect */
  function initCopy() {
    document.querySelectorAll('.l3-dev__copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var value = btn.getAttribute('data-copy');
        if (!value) return;
        navigator.clipboard.writeText(value).then(function () {
          var original = btn.innerHTML;
          btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
          setTimeout(function () { btn.innerHTML = original; }, 1500);
        });
      });
    });
  }
  initCopy();
  document.addEventListener('astro:after-swap', initCopy);
})();
</script>
<script>
(function () {
  /* Community orbit — scroll-driven animation */
  function initCommunityOrbit() {
    var wrap = document.getElementById('communityOrbitWrap');
    var scene = document.getElementById('communityScene');
    if (!wrap || !scene) return;

    function clamp01(v) { return Math.max(0, Math.min(1, v)); }

    function update() {
      var r = wrap.getBoundingClientRect();
      var vh = window.innerHeight;
      var total = r.height - vh;
      var scrolled = 0 - r.top;
      var p = total <= 0 ? 0 : clamp01(scrolled / total);
      scene.style.setProperty('--p', p.toFixed(4));
    }

    var ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(function () { update(); ticking = false; });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  initCommunityOrbit();
  document.addEventListener('astro:after-swap', initCommunityOrbit);
})();
</script>
