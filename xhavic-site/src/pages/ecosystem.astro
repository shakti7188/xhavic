---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ecosystem — Xhavic"
  description="Applications and partners building on the Xhavic execution network. Explore the growing ecosystem of DeFi, NFT, infrastructure, and tooling projects."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Ecosystem</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">
          Applications and partners<br />building on Xhavic
        </h1>
        <p class="prose-editorial-dark" style="margin-bottom:2.5rem;">
          Xhavic is an early-stage execution network. The ecosystem is in its initial phase
          of development. This page will be updated as projects deploy and partnerships form.
        </p>
        <a href="/developers" class="btn-primary">Build on Xhavic</a>
      </div>
    </div>
  </section>

  <!-- Coming Soon — Application Directory -->
  <div class="section-bordered" data-reveal>
    <div class="container">
      <p class="label-mono" style="margin-bottom:1rem;">Application Directory</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Coming Soon</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        Projects building on or integrating with the Xhavic network.
      </p>

      <div class="grid-3" data-reveal-stagger>
        {[1, 2, 3, 4, 5, 6].map((n) => (
          <div class="card-placeholder" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:180px;text-align:center;">
            <svg style="width:32px;height:32px;color:#a3a3a3;margin-bottom:1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <p style="font-size:14px;font-weight:600;color:#525252;">Coming Soon</p>
            <p style="font-size:12px;color:#a3a3a3;margin-top:4px;">Application slot available</p>
          </div>
        ))}
      </div>

      <p style="text-align:center;margin-top:2.5rem;font-size:14px;color:#737373;max-width:560px;margin-left:auto;margin-right:auto;">
        The Xhavic ecosystem is in early development. These placeholder slots represent
        the categories of applications the network is designed to support. If you are building
        a project and considering Xhavic, see the developer resources below.
      </p>
    </div>
  </div>

  <!-- What Xhavic Supports — light surface bg -->
  <div class="section-bordered" style="background:#fafafa;" data-reveal>
    <div class="container">
      <p class="label-mono" style="margin-bottom:1rem;">Capabilities</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">What the Network Supports</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        Xhavic's architecture is designed for these application categories.
      </p>
      <div class="grid-2" data-reveal-stagger>
        {[
          {
            title: 'DeFi Protocols',
            desc: 'DEX, lending, derivatives, and yield protocols benefit from sub-200ms Instant Wallet finality, native oracle precompiles, and low transaction costs.',
          },
          {
            title: 'NFT & Digital Assets',
            desc: 'Minting, trading, and marketplace operations with fast finality. Secured Wallet enables high-value NFT transfers with reversal protection.',
          },
          {
            title: 'Infrastructure & Tooling',
            desc: 'Bridges, indexers, analytics platforms, and developer tools. Standard EVM tooling works without modification. xhv_* RPC extensions for Xhavic-specific data.',
          },
          {
            title: 'AI Agent Applications',
            desc: 'AI agents as protocol-level participants with deterministic execution, programmatic wallet control, and gas-metered compute for bounded operations.',
          },
        ].map((item) => (
          <div class="card-arch" style="background:#ffffff;">
            <h3 style="font-size:18px;font-weight:700;margin-bottom:0.75rem;">{item.title}</h3>
            <p style="font-size:14px;color:#737373;line-height:1.7;">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA — rounded inset for visual separation from footer -->
  <section style="padding:3rem 0 4rem;">
    <div class="section-inset" data-reveal>
      <div style="text-align:center;max-width:640px;margin:0 auto;">
        <h2 class="heading-section" style="margin-bottom:1rem;">Build on Xhavic</h2>
        <p class="prose-editorial-dark" style="margin-left:auto;margin-right:auto;margin-bottom:2.5rem;">
          The network is EVM-compatible. Your existing Solidity contracts deploy without changes.
          Review the developer documentation to get started.
        </p>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
          <a href="/developers" class="btn-primary">Developer Resources</a>
          <a href="/docs" class="btn-dark">Documentation &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
</BaseLayout>
