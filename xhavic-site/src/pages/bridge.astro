---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bridge — Xhavic"
  description="Bridge the native Xhavic token (XVC) between Ethereum L1 and the Xhavic execution network. No minimum deposit or withdrawal amounts. Fast exit is native to the protocol."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Bridge</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">
          Xhavic Bridge
        </h1>
        <p class="prose-editorial-dark" style="margin-bottom:2.5rem;">
          Transfer the native Xhavic token (XVC) between Ethereum L1 and the Xhavic execution
          network. The bridge currently supports only the native XVC token &mdash; no ERC-20 tokens
          at this time. No minimum deposit or withdrawal amounts. Fast exit is native to the
          protocol with no third-party services required.
        </p>
      </div>
    </div>
  </section>

  <!-- Coming Soon -->
  <div class="section-bordered" data-reveal>
    <div class="container">
      <div style="max-width:680px;margin:0 auto;text-align:center;padding:4rem 0;">

        <!-- Bridge icon -->
        <div style="display:inline-flex;align-items:center;justify-content:center;width:80px;height:80px;border-radius:20px;background:#fafafa;border:1px solid #e5e5e5;margin-bottom:2rem;">
          <svg style="width:36px;height:36px;color:#a3a3a3;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
        </div>

        <h2 class="heading-section" style="margin-bottom:1rem;">Bridge Details</h2>
        <p class="prose-editorial" style="margin-left:auto;margin-right:auto;margin-bottom:2rem;">
          The Xhavic Bridge currently supports only the native XVC token. No ERC-20 tokens
          are supported at this time. There are no minimum deposit or withdrawal amounts.
          Fast exit is native to the protocol &mdash; no third-party services required.
          There is no official Bridge SDK yet; use the API or mobile wallet to interact with the bridge.
        </p>

        <!-- Feature preview -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:3rem;text-align:left;">
          <div class="card-arch" style="text-align:center;">
            <p style="font-size:14px;font-weight:700;margin-bottom:0.25rem;">Supported Token</p>
            <p style="font-size:13px;color:#737373;">Native XVC only</p>
          </div>
          <div class="card-arch" style="text-align:center;">
            <p style="font-size:14px;font-weight:700;margin-bottom:0.25rem;">Minimums</p>
            <p style="font-size:13px;color:#737373;">No minimum amounts</p>
          </div>
          <div class="card-arch" style="text-align:center;">
            <p style="font-size:14px;font-weight:700;margin-bottom:0.25rem;">Fast Exit</p>
            <p style="font-size:13px;color:#737373;">Native to protocol</p>
          </div>
        </div>

        <!-- Contract addresses -->
        <div style="text-align:left;max-width:560px;margin:0 auto 2rem;">
          <p style="font-size:14px;font-weight:700;margin-bottom:1rem;">Testnet Bridge Contracts</p>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            <div style="padding:0.75rem 1rem;border-radius:8px;background:#fafafa;border:1px solid #e5e5e5;">
              <p style="font-size:12px;color:#737373;margin-bottom:0.25rem;">L1 Bridge Gateway</p>
              <code style="font-size:12px;word-break:break-all;">0x9efd6ea3d18dee98698150c7df369fcd2efea3be</code>
            </div>
            <div style="padding:0.75rem 1rem;border-radius:8px;background:#fafafa;border:1px solid #e5e5e5;">
              <p style="font-size:12px;color:#737373;margin-bottom:0.25rem;">L1 Standard Token Bridge</p>
              <code style="font-size:12px;word-break:break-all;">0xe7c9ba625ab8589657bc0e67090694fe141cbda7</code>
            </div>
          </div>
          <p style="font-size:12px;color:#a3a3a3;margin-top:0.75rem;font-style:italic;">Mainnet bridge contracts are under deployment.</p>
        </div>

        <p style="font-size:14px;color:#a3a3a3;margin-bottom:2.5rem;">
          No official Bridge SDK is available yet. Use the API or mobile wallet to interact
          with the bridge. Review the bridge architecture in the protocol documentation.
        </p>

        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
          <a href="/protocol/architecture" class="btn-primary">Protocol Architecture</a>
          <a href="/docs" class="btn-secondary" target="_blank" rel="noopener">Documentation &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section style="padding:3rem 0 4rem;">
    <div class="section-inset" data-reveal>
      <div style="text-align:center;max-width:640px;margin:0 auto;">
        <h2 class="heading-section" style="margin-bottom:1rem;">Build on Xhavic</h2>
        <p class="prose-editorial-dark" style="margin-left:auto;margin-right:auto;margin-bottom:2.5rem;">
          The network is EVM-compatible. Deploy existing Solidity contracts without changes.
          Review the developer documentation to get started.
        </p>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
          <a href="/developers" class="btn-primary">Developer Resources</a>
          <a href="/community" class="btn-dark">Join Community &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
</BaseLayout>
