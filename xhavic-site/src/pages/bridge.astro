---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bridge — Xhavic"
  description="Bridge assets between Ethereum L1 and the Xhavic execution network. Deposit ETH and ERC-20 tokens to Xhavic, or withdraw back to Ethereum mainnet."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Bridge</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">
          Xhavic Bridge
        </h1>
        <p class="prose-editorial-dark" style="margin-bottom:2.5rem;">
          Transfer assets between Ethereum L1 and the Xhavic execution network.
          Deposit ETH and ERC-20 tokens, or withdraw back to Ethereum mainnet.
        </p>
      </div>
    </div>
  </section>

  <!-- Coming Soon -->
  <div class="section-bordered" data-reveal>
    <div class="container">
      <div style="max-width:680px;margin:0 auto;text-align:center;padding:4rem 0;">

        <!-- Bridge icon -->
        <div style="display:inline-flex;align-items:center;justify-content:center;width:80px;height:80px;border-radius:20px;background:#fafafa;border:1px solid #e5e5e5;margin-bottom:2rem;">
          <svg style="width:36px;height:36px;color:#a3a3a3;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
        </div>

        <h2 class="heading-section" style="margin-bottom:1rem;">Coming Soon</h2>
        <p class="prose-editorial" style="margin-left:auto;margin-right:auto;margin-bottom:2rem;">
          The Xhavic Bridge is currently under development. It will support native ETH deposits,
          ERC-20 token transfers, and cross-chain messaging between Ethereum L1 and Xhavic L2.
        </p>

        <!-- Feature preview -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:3rem;text-align:left;">
          <div class="card-arch" style="text-align:center;">
            <p style="font-size:14px;font-weight:700;margin-bottom:0.25rem;">Deposits</p>
            <p style="font-size:13px;color:#737373;">~10 min confirmation</p>
          </div>
          <div class="card-arch" style="text-align:center;">
            <p style="font-size:14px;font-weight:700;margin-bottom:0.25rem;">Withdrawals</p>
            <p style="font-size:13px;color:#737373;">7-day challenge period</p>
          </div>
          <div class="card-arch" style="text-align:center;">
            <p style="font-size:14px;font-weight:700;margin-bottom:0.25rem;">Tokens</p>
            <p style="font-size:13px;color:#737373;">ETH + ERC-20 support</p>
          </div>
        </div>

        <p style="font-size:14px;color:#a3a3a3;margin-bottom:2.5rem;">
          In the meantime, review the bridge architecture and deposit/withdrawal flows
          in the protocol documentation.
        </p>

        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
          <a href="/protocol/architecture" class="btn-primary">Protocol Architecture</a>
          <a href="/docs" class="btn-secondary" target="_blank" rel="noopener">Documentation &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section style="padding:3rem 0 4rem;">
    <div class="section-inset" data-reveal>
      <div style="text-align:center;max-width:640px;margin:0 auto;">
        <h2 class="heading-section" style="margin-bottom:1rem;">Build on Xhavic</h2>
        <p class="prose-editorial-dark" style="margin-left:auto;margin-right:auto;margin-bottom:2.5rem;">
          The network is EVM-compatible. Deploy existing Solidity contracts without changes.
          Review the developer documentation to get started.
        </p>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
          <a href="/developers" class="btn-primary">Developer Resources</a>
          <a href="/community" class="btn-dark">Join Community &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
</BaseLayout>
