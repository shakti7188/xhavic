---
import BaseLayout from '@/layouts/BaseLayout.astro';

const brandColors = [
  { name: 'Primary Blue', hex: '#2262FF', className: 'bg-primary', ring: 'ring-primary/20' },
  { name: 'Background', hex: '#F6F8FB', className: 'bg-bg', ring: 'ring-gray-200' },
  { name: 'Dark', hex: '#030B1D', className: 'bg-dark', ring: 'ring-gray-300' },
  { name: 'Ink', hex: '#101828', className: 'bg-ink', ring: 'ring-gray-300' },
  { name: 'Muted', hex: '#667085', className: 'bg-muted', ring: 'ring-gray-200' },
  { name: 'Surface', hex: '#F2F4FF', className: 'bg-surface', ring: 'ring-primary/10' },
];

const logoFormats = [
  { name: 'Primary Logo', formats: 'SVG, PNG', desc: 'Full wordmark for light backgrounds.', bgClass: 'bg-bg' },
  { name: 'Icon Only', formats: 'SVG, PNG', desc: 'Logomark for compact spaces and favicons.', bgClass: 'bg-bg' },
  { name: 'White Logo', formats: 'SVG, PNG', desc: 'Full wordmark for dark backgrounds.', bgClass: 'bg-dark' },
  { name: 'Monochrome', formats: 'SVG, PNG', desc: 'Single-color variant for print and restricted palettes.', bgClass: 'bg-bg' },
];
---

<BaseLayout
  title="Media Kit — Xhavic"
  description="Brand assets, logos, color palette, and press materials for Xhavic. Download the complete media kit."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Brand</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">Media Kit</h1>
        <p class="prose-editorial-dark" style="margin-bottom:2.5rem;">
          Brand assets, guidelines, and press materials for editorial and partner use.
        </p>
        <a
          href="/media-kit/xhavic-media-kit.zip"
          class="btn-primary"
          download
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Media Kit
        </a>
      </div>
    </div>
  </section>

  <!-- Logo Assets -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono" style="margin-bottom:1rem;">Logos</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Logo Assets</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        Available in multiple formats and color variants. Minimum clear space: 1x the height of the logomark.
      </p>
      <div class="grid-2" data-reveal-stagger>
        {logoFormats.map((logo) => (
          <div class="card-arch" style="text-align:center;">
            <div class={`${logo.bgClass}`} style="aspect-ratio:16/9;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;border:1px solid #e5e5e5;">
              <span style="font-size:14px;color:#a3a3a3;font-weight:500;">{logo.name}</span>
            </div>
            <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;">{logo.name}</h3>
            <p style="font-size:14px;color:#737373;margin-bottom:0.75rem;">{logo.desc}</p>
            <span class="label-mono" style="color:#2262ff;">{logo.formats}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Brand Colors -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono" style="margin-bottom:1rem;">Palette</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Brand Colors</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        The Xhavic color palette. Use these values for accurate brand representation.
      </p>
      <div class="grid-3" data-reveal-stagger>
        {brandColors.map((color) => (
          <div class="card-arch" style="display:flex;align-items:center;gap:1rem;">
            <div class={`${color.className}`} style="width:48px;height:48px;border-radius:8px;flex-shrink:0;border:1px solid #e5e5e5;"></div>
            <div>
              <p style="font-weight:600;font-size:14px;">{color.name}</p>
              <p style="font-family:monospace;font-size:12px;color:#a3a3a3;">{color.hex}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Typography -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:960px;">
      <p class="label-mono" style="margin-bottom:1rem;">Type</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Typography</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">
        Xhavic uses Plus Jakarta Sans as its primary typeface across all digital surfaces.
      </p>
      <div class="card-arch">
        <div class="grid-2">
          <div>
            <p class="label-mono" style="margin-bottom:0.75rem;">Primary Typeface</p>
            <p style="font-size:2rem;font-weight:800;margin-bottom:0.5rem;">Plus Jakarta Sans</p>
            <p style="font-size:14px;color:#737373;line-height:1.6;">
              Weights: Regular (400), Medium (500), SemiBold (600), Bold (700), ExtraBold (800)
            </p>
          </div>
          <div>
            <p class="label-mono" style="margin-bottom:0.75rem;">Sample</p>
            <p style="font-size:1.75rem;font-weight:800;margin-bottom:0.25rem;">Aa Bb Cc Dd Ee</p>
            <p style="font-size:1.125rem;font-weight:600;margin-bottom:0.25rem;">Ff Gg Hh Ii Jj Kk</p>
            <p style="font-size:1rem;color:#737373;">0123456789 !@#$%&</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Boilerplate -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:720px;">
      <p class="label-mono" style="margin-bottom:1rem;">About</p>
      <h2 class="heading-section" style="margin-bottom:1.5rem;">About Xhavic</h2>
      <p class="prose-editorial">
        Xhavic is an Ethereum Layer-2 execution network built on optimistic rollup architecture.
        It processes transactions off-chain and settles results on Ethereum, delivering over 2,000 TPS
        at an average fee of $0.04 with full EVM compatibility. Xhavic introduces the Dual Wallet System
        — protocol-level transaction risk routing that separates fast composable DeFi from institutional-grade
        reversible settlement — alongside native oracle infrastructure and AI agent execution support.
      </p>
    </div>
  </div>

  <!-- Press Contact -->
  <div class="section-bordered" data-reveal>
    <div class="container" style="max-width:720px;text-align:center;">
      <p class="label-mono" style="margin-bottom:1rem;">Contact</p>
      <h2 class="heading-section" style="margin-bottom:0.75rem;">Press Contact</h2>
      <p class="prose-editorial" style="margin-left:auto;margin-right:auto;margin-bottom:2rem;">
        For press inquiries, partnership requests, or brand usage questions:
      </p>
      <a
        href="mailto:Marketing@xhavic.com"
        class="btn-secondary"
      >
        Marketing@xhavic.com
      </a>
    </div>
  </div>

  <script>
    import '../scripts/reveal.ts';
  </script>
</BaseLayout>
