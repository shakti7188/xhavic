---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const placeholderPosts = [
  { title: 'Introducing Xhavic', category: 'Announcement', desc: 'The genesis post. Why we built Xhavic, our design philosophy, and what comes next.' },
  { title: 'Dual Wallet System Deep Dive', category: 'Engineering', desc: 'A technical breakdown of how the Instant Wallet and Secured Wallet operate at the sequencer level.' },
  { title: 'Testnet Launch Roadmap', category: 'Roadmap', desc: 'Milestones, timelines, and what developers can expect from the public testnet.' },
];
---

<BaseLayout
  title="Blog — Xhavic"
  description="Protocol updates, engineering deep-dives, ecosystem news, and governance proposals from the Xhavic team."
>
  <!-- Hero -->
  <section class="bg-dark text-white" style="padding:6rem 0 5rem;" data-reveal>
    <div class="container">
      <div style="max-width:720px;">
        <p class="label-mono-dark" style="margin-bottom:1.5rem;">Blog</p>
        <h1 class="heading-display" style="margin-bottom:1.5rem;">Blog</h1>
        <p class="prose-editorial-dark">
          Protocol updates, engineering notes, and ecosystem developments.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <div class="section-bordered" data-reveal>
    <div class="container">
      {posts.length === 0 ? (
        <div>
          <p class="label-mono" style="margin-bottom:1rem;">Coming Soon</p>
          <h2 class="heading-section" style="margin-bottom:0.75rem;">Posts are on the way</h2>
          <p class="prose-editorial" style="margin-bottom:3rem;">
            We are preparing our first articles. In the meantime, explore the topics we will cover.
          </p>
          <div class="grid-3" data-reveal-stagger>
            {placeholderPosts.map((post) => (
              <div class="card-arch" style="display:flex;flex-direction:column;">
                <div style="aspect-ratio:16/9;border-radius:8px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;border:1px solid #e5e5e5;">
                  <svg style="width:32px;height:32px;color:#d4d4d4;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <span class="label-mono" style="margin-bottom:0.75rem;">{post.category}</span>
                <h3 style="font-size:18px;font-weight:700;margin-bottom:0.5rem;">{post.title}</h3>
                <p style="font-size:14px;color:#737373;line-height:1.7;flex:1;">{post.desc}</p>
                <span style="font-size:13px;color:#a3a3a3;font-weight:600;margin-top:1rem;display:block;">
                  Coming soon
                </span>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="grid-3" data-reveal-stagger>
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="card-arch"
              style="text-decoration:none;color:inherit;display:flex;flex-direction:column;"
            >
              {post.data.image && (
                <div style="aspect-ratio:16/9;border-radius:12px 12px 0 0;overflow:hidden;margin:-2rem -2rem 1.25rem -2rem;">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt ?? post.data.title}
                    style="width:100%;height:100%;object-fit:cover;"
                    loading="lazy"
                  />
                </div>
              )}
              <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
                <span class="label-mono" style="color:#2262ff;">{post.data.category}</span>
                <time
                  datetime={post.data.publishedAt.toISOString()}
                  class="label-mono"
                >
                  {formatDate(post.data.publishedAt)}
                </time>
              </div>
              <h2 style="font-size:18px;font-weight:700;margin-bottom:0.5rem;">
                {post.data.title}
              </h2>
              <p style="font-size:14px;color:#737373;line-height:1.7;flex:1;">
                {post.data.description}
              </p>
              <span style="color:#2262ff;font-size:14px;font-weight:600;margin-top:1rem;display:inline-flex;align-items:center;gap:4px;">
                Read more
                <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <script>
    import '../../scripts/reveal.ts';
  </script>
</BaseLayout>
