---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const placeholderPosts = [
  { title: 'Introducing Xhavic', category: 'Announcement', desc: 'The genesis post. Why we built Xhavic, our design philosophy, and what comes next.' },
  { title: 'Dual Wallet System Deep Dive', category: 'Engineering', desc: 'A technical breakdown of how the Instant Wallet and Secured Wallet operate at the sequencer level.' },
  { title: 'Testnet Launch Roadmap', category: 'Roadmap', desc: 'Milestones, timelines, and what developers can expect from the public testnet.' },
];
---

<BaseLayout
  title="Blog — Xhavic"
  description="Protocol updates, engineering deep-dives, ecosystem news, and governance proposals from the Xhavic team."
>
  <!-- Hero -->
  <section class="section bg-dark text-white gradient-mesh">
    <div class="container">
      <div class="max-w-3xl">
        <div class="pill mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          Updates
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight">
          <span class="gradient-text-static">Blog</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Protocol updates, engineering notes, and ecosystem developments.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="section bg-white" data-reveal>
    <div class="container">
      {posts.length === 0 ? (
        <div>
          <div class="section-header">
            <span class="pill mb-4">Coming Soon</span>
            <h2 class="section-title">Posts are on the way</h2>
            <p class="section-subtitle">
              We are preparing our first articles. In the meantime, explore the topics we will cover.
            </p>
          </div>
          <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto" data-reveal-stagger>
            {placeholderPosts.map((post) => (
              <div class="accent-card flex flex-col">
                <div class="aspect-video rounded-xl bg-surface flex items-center justify-center mb-5 border border-stroke/20">
                  <svg class="w-10 h-10 text-primary/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <div class="flex items-center gap-3 mb-3">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-pill bg-surface text-primary text-xs font-semibold">
                    {post.category}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-ink mb-2">{post.title}</h3>
                <p class="text-muted text-sm flex-1 leading-relaxed">{post.desc}</p>
                <span class="text-muted/50 text-sm font-semibold mt-4 inline-block">
                  Coming soon
                </span>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger>
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="accent-card group flex flex-col"
            >
              {post.data.image && (
                <div class="aspect-video rounded-xl overflow-hidden mb-5 -mt-2 -mx-2 md:-mt-4 md:-mx-4">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt ?? post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-pill bg-surface text-primary text-xs font-semibold capitalize">
                  {post.data.category}
                </span>
                <time
                  datetime={post.data.publishedAt.toISOString()}
                  class="text-xs text-muted"
                >
                  {formatDate(post.data.publishedAt)}
                </time>
              </div>
              <h2 class="text-xl font-bold text-ink mb-2 group-hover:text-primary transition-colors">
                {post.data.title}
              </h2>
              <p class="text-muted text-sm flex-1 leading-relaxed">
                {post.data.description}
              </p>
              <span class="text-primary text-sm font-semibold mt-4 inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Read more
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <script>
    import '../../scripts/reveal.ts';
  </script>
</BaseLayout>
