---
import BaseLayout from '@/layouts/BaseLayout.astro';

const tocSections = [
  { num: '1', title: 'Abstract', desc: 'High-level summary of the Xhavic protocol and its design rationale.' },
  { num: '2', title: 'Introduction', desc: 'Problem statement, market context, and why another Layer-2 execution network.' },
  { num: '3', title: 'Design Philosophy', desc: 'Five guiding principles: Ethereum alignment, security inheritance, modularity, progressive decentralization, practical focus.' },
  { num: '4', title: 'Architecture', desc: 'Six-layer modular architecture overview and inter-layer communication model.' },
  { num: '5', title: 'Execution Layer', desc: 'EVM compatibility, bytecode execution, gas metering, and precompile integration.' },
  { num: '6', title: 'Sequencer', desc: 'Transaction ordering, batch submission, MEV mitigation, and sequencer rotation roadmap.' },
  { num: '7', title: 'Settlement', desc: 'Ethereum anchoring via CanonicalTransactionChain, state root commitments, and finality model.' },
  { num: '8', title: 'Dual Wallet System', desc: 'Instant Wallet and Secured Wallet design, escrow periods, and risk routing.' },
  { num: '9', title: 'Data Availability', desc: 'Calldata posting, blob transactions, Merkle commitments, and state reconstruction.' },
  { num: '10', title: 'Bridge', desc: 'Deposit and withdrawal flows, canonical bridge contracts, and LP fast-exit mechanism.' },
  { num: '11', title: 'Tokenomics', desc: 'XHV token utility, distribution schedule, staking mechanics, and fee model.' },
  { num: '12', title: 'Oracle + AI Agents', desc: 'Native oracle precompiles, AI agent execution framework, and deterministic compute.' },
  { num: '13', title: 'Governance', desc: 'DAO structure, four governance domains, proposal lifecycle, and voting mechanics.' },
  { num: '14', title: 'Performance Benchmarks', desc: 'TPS measurements, fee comparisons, finality timings, and scalability projections.' },
  { num: '15', title: 'Security Model', desc: 'Fraud proofs, interactive bisection protocol, challenge windows, and slashing conditions.' },
  { num: '16', title: 'Formal Verification', desc: 'Verified invariants, audit scope, and correctness guarantees.' },
  { num: '17', title: 'Ecosystem & Integrations', desc: 'Wallet support, indexer compatibility, RPC endpoints, and developer tooling.' },
  { num: '18', title: 'Regulatory Considerations', desc: 'Compliance framework, jurisdictional analysis, and risk disclosures.' },
  { num: '19', title: 'Comparison with Existing L2s', desc: 'Feature and performance comparison against Arbitrum, Optimism, zkSync, and others.' },
  { num: '20', title: 'Challenges & Future Directions', desc: 'Known limitations, open research problems, and development roadmap.' },
];
---

<BaseLayout
  title="Technical Whitepaper — Xhavic"
  description="XHAVIC Technical Whitepaper v1.0 — complete protocol specification covering architecture, execution, settlement, tokenomics, governance, and security."
>
  <!-- Hero -->
  <section class="section bg-dark text-white gradient-mesh">
    <div class="container">
      <div class="max-w-3xl">
        <div class="pill mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          Version 1.0
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight">
          <span class="gradient-text-static">Xhavic Technical Whitepaper</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-2">
          January 2026
        </p>
        <p class="text-gray-400 mb-8 max-w-2xl leading-relaxed">
          Complete protocol specification: architecture, execution model, settlement,
          tokenomics, governance, and security analysis.
        </p>
        <a
          href="/whitepaper/XHAVIC_Whitepaper_v1.0.pdf"
          class="btn-primary"
          download
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </section>

  <!-- Table of Contents -->
  <section class="section bg-white" data-reveal>
    <div class="container">
      <div class="section-header">
        <span class="pill mb-4">20 Sections</span>
        <h2 class="section-title">Table of Contents</h2>
        <p class="section-subtitle">
          A comprehensive specification covering every aspect of the Xhavic protocol.
        </p>
      </div>

      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-4" data-reveal-stagger>
        {tocSections.map((section) => (
          <div class="accent-card flex items-start gap-4 !p-5">
            <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center">
              <span class="text-primary text-sm font-bold">{section.num}</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-ink">{section.title}</h3>
              <p class="text-muted text-sm mt-0.5 leading-relaxed">{section.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inline Rendering Placeholder -->
  <section class="section bg-surface" data-reveal>
    <div class="container max-w-3xl text-center">
      <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold mb-4 text-ink">
        Inline HTML Rendering Coming Soon
      </h2>
      <p class="text-muted mb-8 max-w-xl mx-auto leading-relaxed">
        A fully navigable HTML version of the whitepaper will be published here.
        In the meantime, download the PDF for the complete specification.
      </p>
      <a
        href="/whitepaper/XHAVIC_Whitepaper_v1.0.pdf"
        class="btn-primary"
        download
      >
        Download PDF
      </a>
    </div>
  </section>

  <script>
    import '../scripts/reveal.ts';
  </script>
</BaseLayout>
