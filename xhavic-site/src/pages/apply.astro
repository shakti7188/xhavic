---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Apply to Build on XHAVIC — Builder Program"
  description="Apply for the XHAVIC Builder Program. Founders and developers can apply for grants, credits, and ecosystem support to build on Xhavic."
>
  <!-- Hero / Banner -->
  <section class="bg-dark text-white" style="padding:5rem 0 4rem;">
    <div class="container" style="max-width:860px;text-align:center;">
      <p class="label-mono-dark" style="margin-bottom:1rem;">Builder Program</p>
      <h1 class="heading-display text-white" style="margin-bottom:1rem;">Apply for Founder Credit</h1>
      <p class="prose-editorial-dark" style="margin:0 auto 3rem;">
        Whether you're a founder building your next product or a developer ready to deploy on Xhavic —
        we have grants, ecosystem support, and credits waiting for you.
      </p>

      <!-- Two path cards -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;max-width:640px;margin:0 auto;">
        <a href="#apply-form" style="display:block;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.14);border-radius:14px;padding:2rem;text-decoration:none;color:#fff;transition:background 180ms ease;text-align:left;">
          <div style="font-size:28px;margin-bottom:0.75rem;">🏗️</div>
          <h3 style="font-size:16px;font-weight:700;margin-bottom:0.4rem;">Are you a Founder?</h3>
          <p style="font-size:13px;color:rgba(255,255,255,0.55);margin:0 0 1rem;line-height:1.5;">Apply for credits and grants to launch your project on Xhavic.</p>
          <span style="font-size:13px;font-weight:600;color:#2262ff;">Apply for Credits &rarr;</span>
        </a>
        <a href="#apply-form" style="display:block;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.14);border-radius:14px;padding:2rem;text-decoration:none;color:#fff;transition:background 180ms ease;text-align:left;">
          <div style="font-size:28px;margin-bottom:0.75rem;">💻</div>
          <h3 style="font-size:16px;font-weight:700;margin-bottom:0.4rem;">Are you a Developer?</h3>
          <p style="font-size:13px;color:rgba(255,255,255,0.55);margin:0 0 1rem;line-height:1.5;">Join the quest, earn rewards, and build your blockchain portfolio.</p>
          <span style="font-size:13px;font-weight:600;color:#2262ff;">Join Quest &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Application Form -->
  <section id="apply-form" style="padding:5rem 0 6rem;background:#f6f8fb;">
    <div class="container" style="max-width:720px;">
      <p class="label-mono" style="margin-bottom:0.75rem;">Application</p>
      <h2 class="heading-section" style="margin-bottom:0.5rem;">XHAVIC Builder Program</h2>
      <p class="prose-editorial" style="margin-bottom:3rem;">Fill out the form below. We review every application and respond within 5 business days.</p>

      <form id="apply-form-el" action="https://formsubmit.co/press@xhavic.io" method="POST" enctype="multipart/form-data" style="display:grid;gap:2.5rem;">
        <input type="hidden" name="_subject" value="New XHAVIC Builder Program Application" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />

        <!-- Section 1: Basic Information -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 1 — Basic Information</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div style="grid-column:span 2;">
              <label class="form-label">Full Name *</label>
              <input type="text" name="full_name" required placeholder="Your full name" class="form-input" />
            </div>
            <div>
              <label class="form-label">Email Address *</label>
              <input type="email" name="email" required placeholder="you@example.com" class="form-input" />
            </div>
            <div>
              <label class="form-label">Telegram ID / Username *</label>
              <input type="text" name="telegram" required placeholder="@yourhandle" class="form-input" />
            </div>
            <div style="grid-column:span 2;">
              <label class="form-label">Country *</label>
              <input type="text" name="country" required placeholder="e.g. United Arab Emirates" class="form-input" />
            </div>
          </div>
        </div>

        <!-- Section 2: Profile Type -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 2 — Profile Type</p>
          <label class="form-label">Select your role *</label>
          <div style="display:grid;gap:0.75rem;margin-top:0.75rem;">
            <label class="form-radio-label">
              <input type="radio" name="role" value="Developer (Hackathon Participant)" required class="form-radio" />
              <span>Developer (Hackathon Participant)</span>
            </label>
            <label class="form-radio-label">
              <input type="radio" name="role" value="Founder / Startup (Grant Applicant)" class="form-radio" />
              <span>Founder / Startup (Grant Applicant)</span>
            </label>
            <label class="form-radio-label">
              <input type="radio" name="role" value="Both" class="form-radio" />
              <span>Both</span>
            </label>
          </div>
        </div>

        <!-- Section 3: Project Info -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 3 — Project / Website Info</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div style="grid-column:span 2;">
              <label class="form-label">Project Name *</label>
              <input type="text" name="project_name" required placeholder="Your project name" class="form-input" />
            </div>
            <div>
              <label class="form-label">Website / Landing Page</label>
              <input type="url" name="website" placeholder="https://yourproject.io" class="form-input" />
            </div>
            <div>
              <label class="form-label">GitHub / Portfolio Link</label>
              <input type="url" name="github" placeholder="https://github.com/yourhandle" class="form-input" />
            </div>
            <div>
              <label class="form-label">Twitter / X Profile</label>
              <input type="url" name="twitter" placeholder="https://x.com/yourhandle" class="form-input" />
            </div>
            <div>
              <label class="form-label">LinkedIn Profile</label>
              <input type="url" name="linkedin" placeholder="https://linkedin.com/in/yourname" class="form-input" />
            </div>
          </div>
        </div>

        <!-- Section 4: Purpose -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 4 — Purpose of Application</p>
          <label class="form-label" style="margin-bottom:0.75rem;">Why are you applying? (Select all that apply)</label>
          <div style="display:grid;gap:0.6rem;margin-top:0.75rem;">
            {[
              'Build dApp on XHAVIC',
              'Participate in Hackathon',
              'Apply for Grants / Funding',
              'Explore AI + Blockchain integration',
              'RWA / Fintech / Payments use case',
            ].map(opt => (
              <label class="form-checkbox-label">
                <input type="checkbox" name="purpose[]" value={opt} class="form-checkbox" />
                <span>{opt}</span>
              </label>
            ))}
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <label class="form-checkbox-label" style="flex-shrink:0;">
                <input type="checkbox" name="purpose[]" value="Other" class="form-checkbox" id="purpose-other-cb" />
                <span>Other</span>
              </label>
              <input type="text" name="purpose_other" placeholder="Specify..." id="purpose-other-input" class="form-input" style="flex:1;display:none;" />
            </div>
          </div>
        </div>

        <!-- Section 5: Project Details -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 5 — Project Details</p>
          <div style="display:grid;gap:1rem;">
            <div>
              <label class="form-label">Short Project Description (2–3 lines) *</label>
              <textarea name="project_description" required rows="3" placeholder="What does your project do?" class="form-input form-textarea"></textarea>
            </div>
            <div>
              <label class="form-label">Problem you are solving *</label>
              <textarea name="problem" required rows="3" placeholder="What problem does this solve?" class="form-input form-textarea"></textarea>
            </div>
            <div>
              <label class="form-label">Target users / audience *</label>
              <input type="text" name="target_users" required placeholder="e.g. DeFi traders, enterprise treasury teams" class="form-input" />
            </div>
            <div>
              <label class="form-label">Key features / functionality *</label>
              <textarea name="key_features" required rows="3" placeholder="List the main features" class="form-input form-textarea"></textarea>
            </div>
            <div>
              <label class="form-label">How does blockchain add value? *</label>
              <textarea name="blockchain_value" required rows="3" placeholder="Why does this need to be on-chain?" class="form-input form-textarea"></textarea>
            </div>
          </div>
        </div>

        <!-- Section 6: Technical Details -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 6 — Technical Details</p>
          <div style="display:grid;gap:1.25rem;">
            <div>
              <label class="form-label" style="margin-bottom:0.75rem;">Current Stage</label>
              <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.5rem;">
                {['Idea', 'MVP', 'Live Product'].map(s => (
                  <label class="form-radio-label">
                    <input type="radio" name="stage" value={s} class="form-radio" />
                    <span>{s}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <label class="form-label">Tech Stack Used / Planned</label>
              <input type="text" name="tech_stack" placeholder="e.g. Solidity, React, Node.js, IPFS" class="form-input" />
            </div>
            <div>
              <label class="form-label" style="margin-bottom:0.75rem;">Will you integrate:</label>
              <div style="display:grid;gap:0.6rem;margin-top:0.5rem;">
                {[
                  'AI Agents',
                  'Dual Wallet (Instant + Secured)',
                  'RWA Assets',
                  'Payments (Xcentra Integration)',
                ].map(opt => (
                  <label class="form-checkbox-label">
                    <input type="checkbox" name="integrations[]" value={opt} class="form-checkbox" />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Section 7: Traction (Founders) -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 7 — Traction <span style="font-weight:400;font-style:italic;text-transform:none;letter-spacing:0;">(For Founders)</span></p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div>
              <label class="form-label">Current users / community size</label>
              <input type="text" name="users" placeholder="e.g. 500 users, 2K Discord" class="form-input" />
            </div>
            <div>
              <label class="form-label">Funding raised (if any)</label>
              <input type="text" name="funding" placeholder="e.g. $50K pre-seed" class="form-input" />
            </div>
            <div>
              <label class="form-label">Revenue (optional)</label>
              <input type="text" name="revenue" placeholder="e.g. $5K MRR" class="form-input" />
            </div>
            <div>
              <label class="form-label">Partnerships (if any)</label>
              <input type="text" name="partnerships" placeholder="e.g. Chainlink, Uniswap" class="form-input" />
            </div>
          </div>
        </div>

        <!-- Section 8: Expectations -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 8 — Expectations</p>
          <label class="form-label" style="margin-bottom:0.75rem;">What do you expect from XHAVIC? (Select all that apply)</label>
          <div style="display:grid;gap:0.6rem;margin-top:0.75rem;">
            {[
              'Technical Support',
              'Funding / Grants',
              'Exposure / Marketing',
              'Investor Connect',
              'Ecosystem Integration',
            ].map(opt => (
              <label class="form-checkbox-label">
                <input type="checkbox" name="expectations[]" value={opt} class="form-checkbox" />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Section 9: Additional Info -->
        <div class="card-arch">
          <p class="label-mono" style="margin-bottom:1.25rem;">Section 9 — Additional Info</p>
          <div style="display:grid;gap:1rem;">
            <div>
              <label class="form-label">Pitch Deck (Link)</label>
              <input type="url" name="pitch_deck" placeholder="https://drive.google.com/..." class="form-input" />
            </div>
            <div>
              <label class="form-label">Demo Video (Optional)</label>
              <input type="url" name="demo_video" placeholder="https://youtube.com/..." class="form-input" />
            </div>
            <div>
              <label class="form-label">Anything else you want us to know</label>
              <textarea name="additional_info" rows="4" placeholder="Share anything that helps us understand your vision..." class="form-input form-textarea"></textarea>
            </div>
          </div>
        </div>

        <!-- Submit -->
        <div style="text-align:center;">
          <button type="submit" class="btn-primary" style="font-size:16px;padding:16px 48px;">
            👉 Apply to Build on XHAVIC
          </button>
          <p style="margin-top:1rem;font-size:12px;color:#a3a3a3;">We review every application and respond within 5 business days.</p>
        </div>
      </form>

      <!-- Success state (hidden by default) -->
      <div id="apply-success" style="display:none;text-align:center;padding:5rem 2rem;">
        <div style="font-size:56px;margin-bottom:1.5rem;">🚀</div>
        <h2 style="font-size:28px;font-weight:800;margin-bottom:0.75rem;color:#101828;">Application received!</h2>
        <p style="font-size:15px;color:#737373;line-height:1.6;max-width:440px;margin:0 auto;">
          We review every application and will get back to you within 5 business days.
          Follow us on <a href="https://x.com/Xhavicofficial" target="_blank" rel="noopener" style="color:#2262ff;">Twitter/X</a> for program updates.
        </p>
      </div>
    </div>
  </section>

  <script>
    document.getElementById('purpose-other-cb')?.addEventListener('change', (e) => {
      const input = document.getElementById('purpose-other-input') as HTMLElement;
      input.style.display = (e.target as HTMLInputElement).checked ? 'block' : 'none';
    });

    // AJAX submission to show success state instead of redirect
    const applyForm = document.getElementById('apply-form-el') as HTMLFormElement;
    const applySuccess = document.getElementById('apply-success') as HTMLElement;

    applyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(applyForm);
      try {
        await fetch('https://formsubmit.co/ajax/press@xhavic.io', {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
        });
      } catch (_) {}
      applyForm.style.display = 'none';
      applySuccess.style.display = 'block';
      window.scrollTo({ top: (document.getElementById('apply-form') as HTMLElement)?.offsetTop ?? 0, behavior: 'smooth' });
    });
  </script>

  <style>
    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 5px;
    }
    .form-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #e5e5e5;
      border-radius: 8px;
      font-size: 14px;
      font-family: var(--font-family, sans-serif);
      background: #fff;
      color: #171717;
      outline: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .form-input:focus {
      border-color: #2262ff;
      box-shadow: 0 0 0 3px rgba(34, 98, 255, 0.1);
    }
    .form-textarea {
      resize: vertical;
      min-height: 80px;
    }
    .form-radio-label,
    .form-checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 14px;
      color: #374151;
      cursor: pointer;
    }
    .form-radio,
    .form-checkbox {
      width: 16px;
      height: 16px;
      accent-color: #2262ff;
      flex-shrink: 0;
      cursor: pointer;
    }
  </style>
</BaseLayout>
