---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Users — Xhavic"
  description="Same wallet, lower fees, two ways to transact. Connect your existing Ethereum wallet and start using Xhavic with the Dual Wallet System."
>
  <!-- Hero — Dark -->
  <section class="section bg-dark text-white py-20 md:py-30" data-reveal>
    <div class="container text-center">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold mb-6 tracking-tight max-w-4xl mx-auto">
        <span class="gradient-text-static">Same wallet. Lower fees.<br class="hidden md:block" /> Two ways to transact.</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        Xhavic is an Ethereum Layer-2 network. Your existing wallet, addresses, and tokens
        work here. The difference: lower costs, faster confirmations, and a choice between
        two transaction modes.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mb-16">
        <a href="https://bridge.xhavic.io" class="btn-primary" target="_blank" rel="noopener">Bridge to Xhavic</a>
        <a href="#getting-started" class="btn-dark">How to Start</a>
      </div>

      <!-- Stats Strip -->
      <div class="stats-strip max-w-3xl mx-auto" style="grid-template-columns: repeat(3, 1fr);" data-reveal-stagger>
        <div class="stat-item">
          <div class="stat-value">
            <span data-count-to="0.04" data-count-prefix="$">0</span>
          </div>
          <div class="stat-label">Avg Transaction Fee</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">
            &lt;<span data-count-to="200">0</span><span class="text-lg font-bold ml-0.5">ms</span>
          </div>
          <div class="stat-label">Soft Finality</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">
            <span data-count-to="100">0</span><span class="text-lg font-bold">%</span>
          </div>
          <div class="stat-label">EVM Compatible</div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Changes — White bg, bento grid -->
  <section class="section" data-reveal>
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">What Changes for You</h2>
        <p class="section-subtitle">
          Most things stay the same. A few things get better.
        </p>
      </div>
      <div class="bento-grid" data-reveal-stagger>
        <!-- Large card: Same Wallet -->
        <div class="bento-lg accent-card p-8 md:p-10">
          <div class="flex items-start gap-6">
            <div class="flex flex-col gap-3 flex-shrink-0">
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center">
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div class="hidden md:flex flex-col gap-2 mt-2">
                <div class="w-10 h-10 rounded-xl bg-surface border border-stroke/50 flex items-center justify-center" title="MetaMask">
                  <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                </div>
                <div class="w-10 h-10 rounded-xl bg-surface border border-stroke/50 flex items-center justify-center" title="WalletConnect">
                  <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                </div>
              </div>
            </div>
            <div>
              <h3 class="text-2xl md:text-3xl font-bold mb-3 text-ink">Same Wallet</h3>
              <p class="text-muted leading-relaxed mb-4">
                MetaMask, Rabby, Coinbase Wallet, WalletConnect — any Ethereum-compatible wallet works.
                Your private keys and addresses do not change.
              </p>
              <p class="text-muted text-sm leading-relaxed">
                Xhavic uses the same address format, key derivation, and transaction signing as Ethereum mainnet. Simply add the Xhavic RPC endpoint to your existing wallet and you are ready.
              </p>
            </div>
          </div>
        </div>

        <!-- Smaller card: Lower Fees -->
        <div class="accent-card">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-ink">Lower Fees</h3>
          <p class="text-muted text-sm leading-relaxed">
            Transaction costs are a fraction of Ethereum mainnet. Xhavic batches transactions
            off-chain and posts compressed data to Ethereum, spreading L1 costs across many users.
          </p>
        </div>

        <!-- Smaller card: Faster Confirmations -->
        <div class="accent-card">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-ink">Faster Confirmations</h3>
          <p class="text-muted text-sm leading-relaxed">
            Transactions confirm in seconds instead of minutes. The sequencer provides
            soft finality within 2-5 seconds, with final Ethereum settlement following.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Two Ways to Transact (Dual Wallet) — bg-surface -->
  <section class="section bg-surface rounded-2xl mx-4 md:mx-8" data-reveal>
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Two Ways to Transact</h2>
        <p class="section-subtitle">
          When you use Xhavic, you choose between two transaction modes depending on
          what you need. Each mode is a separate wallet type.
        </p>
      </div>
      <div class="split-section max-w-5xl mx-auto" data-reveal-stagger>
        <!-- Instant Wallet -->
        <div class="premium-card bg-white border-l-4 border-l-primary p-8 md:p-10" style="border: 1px solid rgba(16,24,40,0.08); border-left: 4px solid #2262ff;">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 rounded-xl bg-primary flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-primary">Instant Wallet</h3>
          </div>
          <p class="text-muted text-sm mb-6 leading-relaxed">
            For everyday transactions. Fast, final, and irreversible — like paying cash.
          </p>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Confirms in under 200 milliseconds</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Once sent, it cannot be reversed</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Works with all DeFi applications</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Best for: trading, swaps, gaming, payments</span>
            </li>
          </ul>
        </div>

        <!-- Secured Wallet -->
        <div class="premium-card bg-white border-l-4 border-l-amber-500 p-8 md:p-10" style="border: 1px solid rgba(16,24,40,0.08); border-left: 4px solid #f59e0b;">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 rounded-xl bg-amber-500 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-amber-600">Secured Wallet</h3>
          </div>
          <p class="text-muted text-sm mb-6 leading-relaxed">
            For high-value operations. Includes a 24-hour window where the transaction can be reversed.
          </p>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>24-hour escrow before finalization</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Can be reversed during the window</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Does not interact with DeFi until finalized</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>Best for: large transfers, treasury operations</span>
            </li>
          </ul>
        </div>
      </div>
      <p class="footnote text-center mt-8">
        The wallet type is selected when you set up your account. You can hold both types simultaneously.
      </p>
    </div>
  </section>

  <!-- Getting Started — White bg, timeline -->
  <section class="section" id="getting-started" data-reveal>
    <div class="container max-w-3xl">
      <div class="section-header">
        <h2 class="section-title">Four Steps to Start Using Xhavic</h2>
      </div>
      <div class="timeline timeline-light" data-reveal-stagger>
        <div class="timeline-item pb-10">
          <div class="flex items-start gap-5">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">1</span>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-ink">Connect Your Wallet</h3>
              <p class="text-muted leading-relaxed">
                Open MetaMask or any Ethereum-compatible wallet. No new wallet software is needed.
              </p>
            </div>
          </div>
        </div>
        <div class="timeline-item pb-10">
          <div class="flex items-start gap-5">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">2</span>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-ink">Add the Xhavic Network</h3>
              <p class="text-muted leading-relaxed">
                Add the Xhavic RPC endpoint to your wallet. Chain ID: 7849. RPC URL: https://rpc.xhavic.io. This tells your wallet to send transactions to the Xhavic network instead of Ethereum mainnet.
              </p>
            </div>
          </div>
        </div>
        <div class="timeline-item pb-10">
          <div class="flex items-start gap-5">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">3</span>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-ink">Bridge Your Assets</h3>
              <p class="text-muted leading-relaxed">
                Use the Xhavic Bridge to move ETH or ERC-20 tokens from Ethereum to Xhavic. Deposits take approximately 10 minutes to confirm.
              </p>
            </div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="flex items-start gap-5">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">4</span>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2 text-ink">Use Applications</h3>
              <p class="text-muted leading-relaxed">
                Interact with any dApp deployed on Xhavic. The experience is identical to Ethereum mainnet, with lower fees and faster confirmations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bridging — Dark bg,, glass-card -->
  <section class="section bg-dark text-white" data-reveal>
    <div class="container max-w-5xl">
      <div class="section-header">
        <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4 tracking-tight">Bridging Assets</h2>
        <p class="text-base md:text-lg text-gray-400 max-w-2xl mx-auto">
          Moving tokens between Ethereum and Xhavic requires the canonical bridge.
          Timing differs between deposits and withdrawals.
        </p>
      </div>
      <div class="split-section" data-reveal-stagger>
        <!-- Deposit -->
        <div class="glass-card">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-green-400">Deposit</h3>
          </div>
          <p class="text-sm text-gray-400 mb-2 font-medium">Ethereum &rarr; Xhavic</p>
          <p class="text-gray-300 text-sm mb-6 leading-relaxed">
            Send tokens to the bridge contract on Ethereum. After sufficient L1 confirmations,
            your tokens appear on Xhavic.
          </p>
          <div class="flex justify-between items-center py-4 border-t border-white/10">
            <span class="text-gray-500 text-sm">Estimated Time</span>
            <span class="font-bold text-white text-lg">~10 min</span>
          </div>
        </div>

        <!-- Withdrawal -->
        <div class="glass-card">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-amber-400">Withdraw</h3>
          </div>
          <p class="text-sm text-gray-400 mb-2 font-medium">Xhavic &rarr; Ethereum</p>
          <p class="text-gray-300 text-sm mb-6 leading-relaxed">
            Withdrawals require a 7-day challenge period for fraud proof verification.
            This is a security property of optimistic rollups, not a Xhavic-specific limitation.
          </p>
          <div class="flex justify-between items-center py-4 border-t border-white/10">
            <span class="text-gray-500 text-sm">Challenge Period</span>
            <span class="font-bold text-white text-lg">7 days</span>
          </div>
        </div>
      </div>
      <p class="text-center text-xs text-gray-500 italic mt-8">
        LP-based fast exit services may offer faster withdrawals once available. These are third-party services, not operated by the protocol.
      </p>
    </div>
  </section>

  <!-- FAQ — White bg, accordion -->
  <section class="section" data-reveal>
    <div class="container max-w-3xl">
      <div class="section-header">
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-4" data-reveal-stagger>
        <details class="accent-card group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="font-bold text-lg pr-4 text-ink">Do I need a new wallet?</h3>
            <svg class="w-5 h-5 text-muted flex-shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-muted mt-4 leading-relaxed">No. Any Ethereum-compatible wallet works. You add the Xhavic network to your existing wallet the same way you add any EVM network — by adding the RPC URL and chain ID.</p>
        </details>
        <details class="accent-card group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="font-bold text-lg pr-4 text-ink">Are my private keys different on Xhavic?</h3>
            <svg class="w-5 h-5 text-muted flex-shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-muted mt-4 leading-relaxed">No. Xhavic uses the same address format and key derivation as Ethereum. Your address on Xhavic is identical to your address on Ethereum mainnet.</p>
        </details>
        <details class="accent-card group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="font-bold text-lg pr-4 text-ink">Why do withdrawals take 7 days?</h3>
            <svg class="w-5 h-5 text-muted flex-shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-muted mt-4 leading-relaxed">Xhavic is an optimistic rollup. The 7-day window allows validators to submit fraud proofs if the sequencer posts an invalid state. This is the same mechanism used by other optimistic rollups and is essential for inheriting Ethereum security.</p>
        </details>
        <details class="accent-card group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="font-bold text-lg pr-4 text-ink">Can I switch between Instant and Secured wallet?</h3>
            <svg class="w-5 h-5 text-muted flex-shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-muted mt-4 leading-relaxed">You can hold both wallet types simultaneously. Each type is a separate account with its own address. You choose which to use for each operation based on your needs.</p>
        </details>
        <details class="accent-card group">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="font-bold text-lg pr-4 text-ink">What tokens are available on Xhavic?</h3>
            <svg class="w-5 h-5 text-muted flex-shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-muted mt-4 leading-relaxed">Any ERC-20 token bridged from Ethereum is available on Xhavic. The bridge creates a canonical representation of the token on the L2. Native tokens deployed directly on Xhavic are also supported.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA — Dark -->
  <section class="bg-dark text-white py-20 md:py-30" data-reveal>
    <div class="container text-center">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight">
        <span class="gradient-text-static">Ready to Start?</span>
      </h2>
      <p class="text-gray-400 mb-10 max-w-xl mx-auto text-lg leading-relaxed">
        Bridge your assets to Xhavic and start using applications with lower fees
        and faster confirmations.
      </p>
      <a href="https://bridge.xhavic.io" class="btn-primary" target="_blank" rel="noopener">
        Bridge to Xhavic
      </a>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
  <script>import '../scripts/counter.ts';</script>
</BaseLayout>
