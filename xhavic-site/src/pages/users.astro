---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Users — Xhavic"
  description="Same wallet, lower fees, two ways to transact. Connect your existing Ethereum wallet and start using Xhavic with the Dual Wallet System."
>
  <!-- ============================================================
       1. HERO — bg-dark, centered text, heading-display
       ============================================================ -->
  <section class="bg-dark text-white py-20 md:py-30" data-reveal>
    <div class="container text-center">
      <p class="label-mono-dark mb-6">FOR USERS</p>

      <h1 class="heading-display text-white mb-6 max-w-4xl mx-auto">
        Same wallet. Lower fees.<br class="hidden md:block" /> Two ways to transact.
      </h1>

      <p class="prose-editorial-dark mx-auto mb-10 max-w-2xl">
        Xhavic is an Ethereum Layer-2 network. Your existing wallet, addresses, and tokens
        work here. The difference: lower costs, faster confirmations, and a choice between
        two transaction modes.
      </p>

      <div class="flex flex-wrap gap-4 justify-center mb-16">
        <a href="https://bridge.xhavic.io" class="btn-primary" target="_blank" rel="noopener">Bridge to Xhavic</a>
        <a href="#getting-started" class="btn-dark">How to Start</a>
      </div>

      <!-- Stats Strip -->
      <div class="stats-strip max-w-3xl mx-auto" style="grid-template-columns: repeat(3, 1fr);" data-reveal-stagger>
        <div class="stat-item">
          <div class="stat-value">
            <span data-count-to="0.04" data-count-prefix="$">0</span>
          </div>
          <div class="stat-label">Avg Transaction Fee</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">
            &lt;<span data-count-to="200">0</span><span class="text-lg font-bold ml-0.5">ms</span>
          </div>
          <div class="stat-label">Soft Finality</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">
            <span data-count-to="100">0</span><span class="text-lg font-bold">%</span>
          </div>
          <div class="stat-label">EVM Compatible</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. WHAT CHANGES — section-bordered, three card-feature in grid-3
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="mb-10">
        <p class="label-mono mb-2">WHAT'S DIFFERENT</p>
        <h2 class="heading-section text-ink mb-3">What Changes for You</h2>
        <p class="prose-editorial">
          Most things stay the same. A few things get better.
        </p>
      </div>

      <div class="grid-3" data-reveal-stagger>
        <!-- Card: Same Wallet -->
        <div class="card-feature">
          <span class="card-number">01</span>
          <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="heading-sub text-ink mb-3">Same Wallet</h3>
          <p class="text-muted leading-relaxed mb-4">
            MetaMask, Rabby, Coinbase Wallet, WalletConnect — any Ethereum-compatible wallet works.
            Your private keys and addresses do not change.
          </p>
          <p class="text-muted text-sm leading-relaxed">
            Xhavic uses the same address format, key derivation, and transaction signing as Ethereum mainnet. Simply add the Xhavic RPC endpoint to your existing wallet and you are ready.
          </p>
        </div>

        <!-- Card: Lower Fees -->
        <div class="card-feature">
          <span class="card-number">02</span>
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
          </div>
          <h3 class="heading-sub text-ink mb-2">Lower Fees</h3>
          <p class="text-muted text-sm leading-relaxed">
            Transaction costs are a fraction of Ethereum mainnet. Xhavic batches transactions
            off-chain and posts compressed data to Ethereum, spreading L1 costs across many users.
          </p>
        </div>

        <!-- Card: Faster Confirmations -->
        <div class="card-feature">
          <span class="card-number">03</span>
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="heading-sub text-ink mb-2">Faster Confirmations</h3>
          <p class="text-muted text-sm leading-relaxed">
            Transactions confirm in seconds instead of minutes. The sequencer provides
            soft finality within 2-5 seconds, with final Ethereum settlement following.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3. TWO WAYS TO TRANSACT — section-inset dark, two columns
       ============================================================ -->
  <section class="section-inset" data-reveal>
    <div class="container">
      <div class="text-center mb-12">
        <p class="label-mono-dark mb-3">DUAL WALLET SYSTEM</p>
        <h2 class="heading-section text-white mb-4">Two Ways to Transact</h2>
        <p class="prose-editorial-dark mx-auto">
          When you use Xhavic, you choose between two transaction modes depending on
          what you need. Each mode is a separate wallet type.
        </p>
      </div>

      <div class="grid-2 max-w-5xl mx-auto" data-reveal-stagger>
        <!-- Instant Wallet -->
        <div class="card-dark-solid heading-accent-blue" style="padding: 2.5rem;">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 rounded-xl bg-primary flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-primary">Instant Wallet</h3>
          </div>
          <p class="text-gray-400 text-sm mb-6 leading-relaxed">
            For everyday transactions. Fast, final, and irreversible — like paying cash.
          </p>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Confirms in under 200 milliseconds</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Once sent, it cannot be reversed</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Works with all DeFi applications</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Best for: trading, swaps, gaming, payments</span>
            </li>
          </ul>
        </div>

        <!-- Secured Wallet -->
        <div class="card-dark-solid heading-accent-gold" style="padding: 2.5rem;">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 rounded-xl bg-amber-500 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-amber-400">Secured Wallet</h3>
          </div>
          <p class="text-gray-400 text-sm mb-6 leading-relaxed">
            For high-value operations. Includes a 24-hour window where the transaction can be reversed.
          </p>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">24-hour escrow before finalization</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Can be reversed during the window</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Does not interact with DeFi until finalized</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-md bg-amber-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span class="text-gray-300">Best for: large transfers, treasury operations</span>
            </li>
          </ul>
        </div>
      </div>

      <p class="footnote text-center mt-8" style="color: rgba(255,255,255,0.4);">
        The wallet type is selected when you set up your account. You can hold both types simultaneously.
      </p>
    </div>
  </section>

  <!-- ============================================================
       4. GETTING STARTED — section-bordered, numbered timeline
       ============================================================ -->
  <section class="section-bordered" id="getting-started" data-reveal>
    <div class="container">
      <div class="grid-40-60">
        <div>
          <p class="label-mono mb-2">HOW IT WORKS</p>
          <h2 class="heading-section text-ink mb-4">Four Steps to Start Using Xhavic</h2>
        </div>

        <div class="section-numbered" data-reveal-stagger>
          <div class="flex items-start gap-5 mb-8 pb-8" style="border-bottom: 1px solid #e5e5e5;">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">1</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Connect Your Wallet</h3>
              <p class="text-muted leading-relaxed">
                Open MetaMask or any Ethereum-compatible wallet. No new wallet software is needed.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-5 mb-8 pb-8" style="border-bottom: 1px solid #e5e5e5;">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">2</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Add the Xhavic Network</h3>
              <p class="text-muted leading-relaxed">
                Add the Xhavic RPC endpoint to your wallet. Chain ID: 7849. RPC URL: https://rpc.xhavic.io. This tells your wallet to send transactions to the Xhavic network instead of Ethereum mainnet.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-5 mb-8 pb-8" style="border-bottom: 1px solid #e5e5e5;">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">3</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Bridge Your Assets</h3>
              <p class="text-muted leading-relaxed">
                Use the Xhavic Bridge to move ETH or ERC-20 tokens from Ethereum to Xhavic. Deposits take approximately 10 minutes to confirm.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-5">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
              <span class="text-white text-sm font-extrabold">4</span>
            </div>
            <div>
              <h3 class="heading-sub text-ink mb-2">Use Applications</h3>
              <p class="text-muted leading-relaxed">
                Interact with any dApp deployed on Xhavic. The experience is identical to Ethereum mainnet, with lower fees and faster confirmations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. BRIDGING — section-bordered, split: deposit + withdrawal
       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="mb-10">
        <p class="label-mono mb-2">BRIDGING</p>
        <h2 class="heading-section text-ink mb-3">Bridging Assets</h2>
        <p class="prose-editorial">
          Moving tokens between Ethereum and Xhavic requires the canonical bridge.
          Timing differs between deposits and withdrawals.
        </p>
      </div>

      <div class="grid-2 max-w-5xl" data-reveal-stagger>
        <!-- Deposit -->
        <div class="card-arch" style="border-top: 3px solid #22c55e;">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-green-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-green-600">Deposit</h3>
          </div>
          <p class="text-sm text-muted mb-2 font-medium">Ethereum &rarr; Xhavic</p>
          <p class="text-muted text-sm mb-6 leading-relaxed">
            Send tokens to the bridge contract on Ethereum. After sufficient L1 confirmations,
            your tokens appear on Xhavic.
          </p>
          <hr class="hr-subtle" style="margin: 1rem 0;" />
          <div class="flex justify-between items-center">
            <span class="text-muted text-sm">Estimated Time</span>
            <span class="font-bold text-ink text-lg">~10 min</span>
          </div>
        </div>

        <!-- Withdrawal -->
        <div class="card-arch" style="border-top: 3px solid #f59e0b;">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-amber-600">Withdraw</h3>
          </div>
          <p class="text-sm text-muted mb-2 font-medium">Xhavic &rarr; Ethereum</p>
          <p class="text-muted text-sm mb-6 leading-relaxed">
            Withdrawals require a 7-day challenge period for fraud proof verification.
            This is a security property of optimistic rollups, not a Xhavic-specific limitation.
          </p>
          <hr class="hr-subtle" style="margin: 1rem 0;" />
          <div class="flex justify-between items-center">
            <span class="text-muted text-sm">Challenge Period</span>
            <span class="font-bold text-ink text-lg">7 days</span>
          </div>
        </div>
      </div>

      <p class="text-center text-xs text-muted italic mt-8">
        LP-based fast exit services may offer faster withdrawals once available. These are third-party services, not operated by the protocol.
      </p>
    </div>
  </section>

  <!-- ============================================================
       6. CTA — bg-dark centered
       ============================================================ -->
  <section class="bg-dark text-white py-20 md:py-30" data-reveal>
    <div class="container text-center">
      <h2 class="heading-display text-white mb-6">
        Ready to Start?
      </h2>
      <p class="prose-editorial-dark mx-auto mb-10">
        Bridge your assets to Xhavic and start using applications with lower fees
        and faster confirmations.
      </p>
      <a href="https://bridge.xhavic.io" class="btn-primary" target="_blank" rel="noopener">
        Bridge to Xhavic
      </a>
    </div>
  </section>

  <script>import '../scripts/reveal.ts';</script>
  <script>import '../scripts/counter.ts';</script>
</BaseLayout>
