  <script>
    // Modal open/close
    const modal = document.getElementById('quest-modal') as HTMLElement;
    const openModal = () => { modal.classList.add('is-open'); document.body.style.overflow = 'hidden'; };
    const closeModal = () => { modal.classList.remove('is-open'); document.body.style.overflow = ''; };
    document.getElementById('quest-btn')?.addEventListener('click', openModal);
    document.getElementById('quest-close')?.addEventListener('click', closeModal);
    document.getElementById('quest-backdrop')?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    // Form submit
    (document.getElementById('quest-form') as HTMLFormElement)?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Submitting...';
      const data = new FormData(form);
      data.append('_subject', 'New Developer Quest Registration - Xhavic');
      data.append('_captcha', 'false');
      // Save to Google Sheet (fire-and-forget GET, no CORS)
      try {
        const sp = new URLSearchParams({
          type: 'Quest',
          name: String(data.get('name') || ''),
          email: String(data.get('email') || ''),
          telegram: String(data.get('telegram') || ''),
          github: String(data.get('github') || ''),
          experience: String(data.get('experience') || ''),
          interest: (data.getAll('interest') as string[]).join(', '),
        });
        new Image().src = 'https://script.google.com/macros/s/AKfycbxidxvZTlpwfSQglTyihF_jV9Jyg64ABMTwBR1o_dgyZqQFAdRhAdxJJk045-sQV1kr/exec?' + sp.toString();
      } catch(_) {}
      try {
        await fetch('https://formsubmit.co/ajax/Marketing@xhavic.com', {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
        });
      } catch (_) {}
      form.style.display = 'none';
      (document.getElementById('quest-success') as HTMLElement).style.display = 'flex';
    });
  </script>

