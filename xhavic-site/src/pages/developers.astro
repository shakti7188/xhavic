       ============================================================ -->
  <section class="section-bordered" data-reveal>
    <div class="container">
      <div class="grid-35-65">
        <!-- Left: Text -->
        <div>
          <p class="label-mono mb-4">TWO PATHS</p>
          <h2 class="heading-section text-ink mb-4">Dual Wallet Integration</h2>
          <p class="prose-editorial mb-6">
            Your contracts interact with two execution paths. The wallet type is determined by the
            originating address, not by contract logic.
          </p>
          <p class="text-sm text-muted">
            Use <code class="text-primary bg-primary/10 px-1.5 py-0.5 rounded text-xs font-mono">xhv_getWalletType(address)</code> to
            detect the wallet type at runtime, and <code class="text-primary bg-primary/10 px-1.5 py-0.5 rounded text-xs font-mono">xhv_getEscrowStatus(txHash)</code> to
            check escrow state for Secured Wallet transactions.
          </p>
        </div>

        <!-- Right: Two styled cards -->
        <div class="space-y-5">
          <div class="card-arch" style="border-left: 3px solid #2262ff;">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="font-bold text-lg text-ink">Instant Wallet Path</h3>
            </div>
            <p class="text-muted text-sm mb-3 leading-relaxed">
              Transactions from Instant Wallets execute immediately with sub-200ms soft finality.
              Fully composable — other contracts can act on the output in the same block.
            </p>
            <code class="text-xs text-primary bg-primary/5 px-2 py-1 rounded font-mono">xhv_getWalletType(address) → "instant"</code>
          </div>

          <div class="card-arch" style="border-left: 3px solid #c4a35a;">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <h3 class="font-bold text-lg text-ink">Secured Wallet Path</h3>
            </div>
            <p class="text-muted text-sm mb-3 leading-relaxed">
              Transactions from Secured Wallets enter a 24-hour escrow period. State changes
              are provisional until the escrow window closes. Non-composable during this period.
            </p>
            <code class="text-xs text-amber-600 bg-amber-500/5 px-2 py-1 rounded font-mono">xhv_getEscrowStatus(txHash) → "pending"</code>
          </div>
        </div>
      </div>
    </div>
  </section>

